<Application x:Class="TKer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TKer.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
                <ResourceDictionary Source="Themes/AppTheme.xaml"/>
                <ResourceDictionary Source="Themes/BootstrapIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:PriorityToBgConverter x:Key="PriorityToBgConverter"/>
            <conv:PriorityToFgConverter x:Key="PriorityToFgConverter"/>
            <conv:StatusToBgConverter  x:Key="StatusToBgConverter"/>
            <conv:StatusToFgConverter  x:Key="StatusToFgConverter"/>
            <conv:BoolToTypeConverter  x:Key="BoolToTypeConverter"/>
            <conv:StringToColorConverter x:Key="StringToColorConverter"/>
            <conv:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            <conv:DelayToColorConverter x:Key="DelayToColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>

            <!-- FormLabel (global) -->
            <Style x:Key="FormLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                    </Style>

            <!-- DayHeader (global) -->
            <Style x:Key="DayHeader" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="0,4"/>
                    </Style>

            <!-- クイックナビボタン (HomePage) -->
            <Style x:Key="QuickNavButton" TargetType="Button">
                <Setter Property="Background"               Value="Transparent"/>
                <Setter Property="BorderThickness"          Value="0"/>
                <Setter Property="Padding"                  Value="10,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor"                   Value="Hand"/>
                <Setter Property="Margin"                   Value="0,0,0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource BgHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource BgSecondaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <conv:AlertLevelToBorderConverter x:Key="AlertLevelToBorderConverter"/>
            <conv:AlertLevelToBgConverter     x:Key="AlertLevelToBgConverter"/>
            <conv:AlertLevelToFgConverter     x:Key="AlertLevelToFgConverter"/>
            <conv:PercentToWidthConverter     x:Key="PercentToWidthConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

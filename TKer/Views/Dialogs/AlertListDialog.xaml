<Window x:Class="TKer.Views.Dialogs.AlertListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="アラート一覧（全プロジェクト）"
        Height="600" Width="820"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="4"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Path Data="{StaticResource Bi.ExclamationTriangleFill}" Style="{StaticResource BiIcon}"
                      Fill="{StaticResource AccentRedBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="アラート一覧 — 全プロジェクト横断"
                           FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- フィルター -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Margin="0,0,8,0" Content="すべて"    Tag="All"      Style="{StaticResource SecondaryButton}"
                        Padding="10,5" FontSize="12" Click="Filter_Click"/>
                <Button Margin="0,0,8,0" Tag="Overdue" Style="{StaticResource SecondaryButton}"
                        Padding="10,5" FontSize="12" Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentRedBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="期限超過" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0" Tag="DueSoon" Style="{StaticResource SecondaryButton}"
                        Padding="10,5" FontSize="12" Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentYellowBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="締切間近" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,0" Tag="NotStarted" Style="{StaticResource SecondaryButton}"
                        Padding="10,5" FontSize="12" Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentOrangeBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="未着手超過" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <DataGrid x:Name="AlertGrid" Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          RowBackground="Transparent" AlternatingRowBackground="#0A1520"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="13" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="AlertGrid_DoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="種別" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding LevelIcon}" FontSize="14" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding LevelLabel}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="プロジェクト" Binding="{Binding ProjectName}" Width="140"/>
                        <DataGridTextColumn Header="タスクID"
                                            Binding="{Binding TaskId}" Width="80"
                                            FontFamily="Consolas" FontSize="11"/>
                        <DataGridTextColumn Header="タスク名" Binding="{Binding TaskName}" Width="*"/>
                        <DataGridTextColumn Header="担当者" Binding="{Binding Assignee}" Width="80"/>
                        <DataGridTextColumn Header="期限日"
                                            Binding="{Binding PlannedEndDate, StringFormat='yyyy/MM/dd'}"
                                            Width="100" FontFamily="Consolas" FontSize="11"/>
                        <DataGridTextColumn Header="残り/超過" Binding="{Binding RemainingLabel}"
                                            Width="90" FontFamily="Consolas" FontSize="12"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock x:Name="CountLabel" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Margin="0,0,8,0" Content="プロジェクトを開く" Style="{StaticResource PrimaryButton}"
                        Click="OpenProject_Click"/>
                <Button Margin="0,0,8,0" Content="閉じる" Style="{StaticResource SecondaryButton}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

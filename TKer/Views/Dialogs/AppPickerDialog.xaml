<Window x:Class="TKer.Views.Dialogs.AppPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリ選択"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgSecondaryBrush}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="ファイルから選択..." Padding="12,5"
                    Click="Browse_Click"/>
            <TextBlock Text="起動中のアプリから選択するか、ファイルを参照してください"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="キャンセル" Width="90" Padding="0,5"
                    IsCancel="True" Click="Cancel_Click"/>
        </DockPanel>

        <ListBox x:Name="RunningList"
                 Background="{DynamicResource BgCardBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MouseDoubleClick="RunningList_DoubleClick"/>
    </DockPanel>
</Window>

<Window x:Class="TKer.Views.Dialogs.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="カテゴリー追加" Height="400" Width="480"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <TextBlock Text="カテゴリー名 *" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"
                         Tag="例: 基本設計"/>

                <TextBlock Text="説明" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtDescription" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,14" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="カラー (HEX)" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtColor" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,24" Tag="#3D7EFF"
                         InputMethod.IsInputMethodEnabled="False"/>

                <CheckBox x:Name="ChkRenameFolder"
                          Content="フォルダ名も変更する"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="12" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" Content="キャンセル" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                    <Button Margin="0,0,8,0" Content="保存" Style="{StaticResource PrimaryButton}" Click="OK_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

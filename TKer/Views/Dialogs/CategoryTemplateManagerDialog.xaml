<Window x:Class="TKer.Views.Dialogs.CategoryTemplateManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="カテゴリーテンプレート管理" Height="620" Width="720"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock x:Name="TitleText"
                           Text="カテゴリーテンプレート管理"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- ── 一覧パネル ── -->
        <Grid x:Name="PanelList" Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 検索バー + 作成ボタン -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="＋ テンプレート作成"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,7" FontSize="12"
                        Click="ShowCreatePanel_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="8,0" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Bi.Search}"
                              Style="{StaticResource BiIcon}"
                              Fill="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 FontFamily="Yu Gothic UI" FontSize="13"
                                 VerticalAlignment="Center" Height="32"
                                 TextChanged="SearchBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock x:Name="Placeholder"
                                                               Text="テンプレート名で検索..."
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontFamily="Yu Gothic UI" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- テンプレート一覧 -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                    <ItemsControl x:Name="TemplateList" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <!-- テンプレート名 + バッジ -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolVis}}"
                                                        Background="#22AAAAAA" CornerRadius="4"
                                                        Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="組み込み" FontSize="10"
                                                               FontFamily="Yu Gothic UI"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- カラードット -->
                                            <ItemsControl ItemsSource="{Binding ColorDots}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="14" Height="14" CornerRadius="3"
                                                                Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding}"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- カテゴリー数 + 削除ボタン -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryCountLabel}"
                                                       FontFamily="Yu Gothic UI" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Visibility="{Binding IsUserCreated, Converter={StaticResource BoolVis}}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="8,4" FontSize="11"
                                                    Tag="{Binding Id}"
                                                    Click="DeleteTemplate_Click">
                                                <Path Data="{StaticResource Bi.Trash3}" Style="{StaticResource BiIcon}"
                                                      Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── 作成パネル ── -->
        <Grid x:Name="PanelCreate" Grid.Row="1" Visibility="Collapsed" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 戻るボタン + タイトル -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource SecondaryButton}" Padding="8,5"
                        Click="BackToList_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Bi.ChevronLeft}" Style="{StaticResource BiIcon}"
                              Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Margin="0,0,4,0"/>
                        <TextBlock Text="一覧に戻る" FontFamily="Yu Gothic UI" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="新規テンプレート作成"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- テンプレート名 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="テンプレート名 *" Style="{StaticResource FormLabel}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtTemplateName"
                         Background="{StaticResource BgSecondaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"
                         FontFamily="Yu Gothic UI" FontSize="13"
                         Padding="10,8" Height="36"/>
            </StackPanel>

            <!-- カテゴリー表ヘッダー -->
            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="カテゴリー名 *"
                           Style="{StaticResource FormLabel}" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="説明"
                           Style="{StaticResource FormLabel}" FontSize="11"/>
                <TextBlock Grid.Column="6" Text="HEX色"
                           Style="{StaticResource FormLabel}" FontSize="11"/>
            </Grid>

            <!-- カテゴリー行リスト -->
            <Border Grid.Row="3"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="6,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CategoryRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BgCardBrush}"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"
                                             FontFamily="Yu Gothic UI" FontSize="12"
                                             Padding="7,5" Height="30"/>

                                    <TextBox Grid.Column="2"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BgCardBrush}"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"
                                             FontFamily="Yu Gothic UI" FontSize="12"
                                             Padding="7,5" Height="30"/>

                                    <!-- カラープレビュー -->
                                    <Border Grid.Column="4" Width="24" Height="24"
                                            CornerRadius="4" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding PreviewColor}"/>
                                        </Border.Background>
                                    </Border>

                                    <TextBox Grid.Column="6"
                                             Text="{Binding HexColor, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BgCardBrush}"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"
                                             FontFamily="Yu Gothic UI" FontSize="12"
                                             Padding="7,5" Height="30"/>

                                    <Button Grid.Column="8"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="26" Height="26" Padding="0"
                                            Tag="{Binding}"
                                            Click="RemoveCategoryRow_Click">
                                        <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                                              Fill="{StaticResource TextSecondaryBrush}" Width="11" Height="11"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- フッター -->
            <DockPanel Grid.Row="4" Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Content="＋ 行を追加"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6" FontSize="12"
                        Click="AddCategoryRow_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                            Padding="14,7" Margin="0,0,8,0"
                            Click="BackToList_Click"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButton}"
                            Padding="14,7"
                            Click="SaveTemplate_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="TKer.Views.Dialogs.ChangelogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="更新履歴 — TKer"
        Height="520" Width="560"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="4"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <Grid Grid.Row="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Path Data="{StaticResource Bi.ArrowClockwise}" Style="{StaticResource BiIcon}"
                      Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="更新履歴" FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="20"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- v1.0.0 -->
                    <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8"
                            Padding="16,12" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="4"
                                        Padding="8,3">
                                    <TextBlock Text="v1.0.0" FontFamily="Consolas" FontSize="12"
                                               Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="2025-06-21" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Border DockPanel.Dock="Right" Background="#3300E676"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="最新" FontSize="11"
                                               Foreground="{StaticResource AccentGreenBrush}"
                                               FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="初回リリース" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="• " Foreground="{StaticResource AccentGreenBrush}"/>
                                <Run Text="プロジェクト作成・管理機能"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentGreenBrush}"/>
                                <Run Text="複数プロジェクト対応（一覧・切替・ピン留め）"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentGreenBrush}"/>
                                <Run Text="カテゴリー・タスク管理（フォルダ自動生成）"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentGreenBrush}"/>
                                <Run Text="ガントチャート（予定/実績バー）"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentGreenBrush}"/>
                                <Run Text="カレンダー / 横一覧スケジュール表示"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentGreenBrush}"/>
                                <Run Text="ホーム画面（全プロジェクト横断アラート）"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentGreenBrush}"/>
                                <Run Text="Excel（WBS/ガントチャート形式）インポート"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- v1.1.0 -->
                    <Border Background="{StaticResource BgSecondaryBrush}" CornerRadius="8"
                            Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="4"
                                        Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="v1.1.0" FontFamily="Consolas" FontSize="12"
                                               Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="2025-06-21" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="改善・バグ修正リリース" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="• " Foreground="{StaticResource AccentOrangeBrush}"/>
                                <Run Text="タスクリスト・ガントチャート・カレンダーのバグ修正"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentBlueBrush}"/>
                                <Run Text="成果物まとめ機能（ZIP生成・INDEX.md・拡張子フィルター）"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentBlueBrush}"/>
                                <Run Text="アプリ設定ダイアログ（猶予日数・完了非表示）"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentBlueBrush}"/>
                                <Run Text="タスクコメント機能"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentBlueBrush}"/>
                                <Run Text="CSVエクスポート・タグ・遅延承認フラグ"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentBlueBrush}"/>
                                <Run Text="キーボードショートカット（Ctrl+F/S/H）"/>
                                <LineBreak/>
                                <Run Text="• " Foreground="{StaticResource AccentBlueBrush}"/>
                                <Run Text="プロジェクト移動時の自動パス修正"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="閉じる" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" Margin="0,12,0,0"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>

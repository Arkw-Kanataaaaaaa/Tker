<Window x:Class="TKer.Views.Dialogs.CollectionDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="コレクション削除" Width="460"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="コレクション削除"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <StackPanel Grid.Row="1" Margin="28,20,28,24">

            <!-- アイコン + タイトル -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="❓" FontSize="22"
                           Foreground="#0B6E99"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="CollectionNameText"
                           FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <!-- メッセージ -->
            <TextBlock Text="このコレクションを削除しますか？"
                       FontFamily="Yu Gothic UI" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- フォルダ削除トグル（コレクションフォルダがある場合のみ表示） -->
            <DockPanel x:Name="FolderDeletePanel" Visibility="Collapsed" Margin="0,0,0,20">
                <!-- トグルスイッチ -->
                <Border x:Name="ToggleTrack" DockPanel.Dock="Right"
                        Width="44" Height="24" CornerRadius="12"
                        Cursor="Hand" MouseLeftButtonUp="ToggleDeleteFolder_Click">
                    <Grid>
                        <Border x:Name="ToggleThumb" Width="20" Height="20" CornerRadius="10"
                                Background="White" HorizontalAlignment="Left"
                                Margin="2,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="コレクションフォルダも削除する"
                               FontFamily="Yu Gothic UI" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="FolderPathText"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>

            <!-- ボタン -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,6" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="削除"
                        Style="{StaticResource DangerFilledButton}"
                        Padding="20,6"
                        Click="Delete_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

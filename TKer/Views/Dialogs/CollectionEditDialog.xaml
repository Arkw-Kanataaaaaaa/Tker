<Window x:Class="TKer.Views.Dialogs.CollectionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新規コレクション"
        Width="520" Height="660" MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgCardBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ スクロール可能なメインコンテンツ ═══ -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,20,24,12">
            <StackPanel>

                <!-- ─── 基本情報セクション ─── -->
                <TextBlock Text="基本情報"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}"
                           Margin="0,0,0,14"/>

                <!-- コレクション名 -->
                <TextBlock Text="コレクション名 *"
                           FontSize="12" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName"
                         Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,12"/>

                <!-- 説明 -->
                <TextBlock Text="説明（任意）"
                           FontSize="12" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDesc"
                         Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,12"/>

                <!-- フォルダパス -->
                <TextBlock Text="コレクションフォルダパス（任意）"
                           FontSize="12" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFolder" Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"/>
                    <Button Grid.Column="1" Content="参照..."
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,5" Margin="6,0,0,0"
                            Click="BrowseFolder_Click"/>
                </Grid>

                <!-- データ形態 -->
                <TextBlock Text="データ形態（例：本、映画、ゲームなど）"
                           FontSize="12" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDataFormat"
                         Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,20"/>

                <!-- セクション区切り -->
                <Border Height="1" Background="{StaticResource BorderBrush}"
                        Margin="0,0,0,18"/>

                <!-- ─── データ付属情報セクション ─── -->
                <TextBlock Text="データ付属情報"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="アイテムに付属させる情報フィールドを定義します"
                           FontSize="11" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,0,0,14"/>

                <!-- 定義済みフィールド一覧 -->
                <StackPanel x:Name="FieldListPanel" Margin="0,0,0,10"/>

                <!-- フィールド追加フォーム -->
                <Border Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="フィールドを追加"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <!-- 付属情報名 -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="付属情報名"
                                           FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtNewFieldName"
                                         Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>

                            <!-- データ形式 -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="データ形式"
                                           FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="CbFieldType"
                                          Style="{StaticResource DarkComboBox}"
                                          SelectedIndex="0">
                                    <ComboBoxItem Style="{StaticResource DarkComboBoxItem}" Tag="文字列">📝 文字列</ComboBoxItem>
                                    <ComboBoxItem Style="{StaticResource DarkComboBoxItem}" Tag="画像" >🖼 画像</ComboBoxItem>
                                    <ComboBoxItem Style="{StaticResource DarkComboBoxItem}" Tag="リンク">🔗 リンク</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button Content="＋ フィールドを追加"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,5" Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Click="AddField_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ フッター：OK / キャンセル ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,6" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button x:Name="BtnOk" Content="作成"
                        Style="{StaticResource PrimaryButton}"
                        Padding="22,6"
                        Click="OK_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

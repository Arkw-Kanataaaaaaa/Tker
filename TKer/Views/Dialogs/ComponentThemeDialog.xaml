<Window x:Class="TKer.Views.Dialogs.ComponentThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="コンポーネント設定"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BgCardBrush}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <StackPanel Grid.Row="1" Margin="24,20">

            <TextBlock x:Name="ComponentLabel"
                       FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

            <!-- 背景色 -->
            <TextBlock Text="背景色（例: #1A2B3C　空欄=デフォルト）" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,14">
                <Border x:Name="BgPreview" Width="28" Height="28" CornerRadius="4"
                        DockPanel.Dock="Right" Margin="8,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                <TextBox x:Name="TxtBgColor" Style="{StaticResource DarkTextBox}"
                         TextChanged="TxtBgColor_TextChanged"/>
            </DockPanel>

            <!-- 文字色 -->
            <TextBlock Text="文字色（HEX　空欄=デフォルト）" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,14">
                <Border x:Name="TextPreview" Width="28" Height="28" CornerRadius="4"
                        DockPanel.Dock="Right" Margin="8,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                <TextBox x:Name="TxtTextColor" Style="{StaticResource DarkTextBox}"
                         TextChanged="TxtTextColor_TextChanged"/>
            </DockPanel>

            <!-- 枠線色 -->
            <TextBlock Text="枠線色（HEX　空欄=デフォルト）" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,14">
                <Border x:Name="BorderPreview" Width="28" Height="28" CornerRadius="4"
                        DockPanel.Dock="Right" Margin="8,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                <TextBox x:Name="TxtBorderColor" Style="{StaticResource DarkTextBox}"
                         TextChanged="TxtBorderColor_TextChanged"/>
            </DockPanel>

            <!-- 透明度 -->
            <TextBlock Text="透明度" FontSize="11"
                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="SliderOpacity" Minimum="0" Maximum="100" Value="100"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource AccentCyanBrush}"
                        ValueChanged="SliderOpacity_Changed"/>
                <TextBlock x:Name="LblOpacity" Grid.Column="1" Text="100%"
                           FontSize="12" FontFamily="Consolas"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- ボタン -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                        Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="適用" Style="{StaticResource PrimaryButton}"
                        Padding="20,6" Click="Apply_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>

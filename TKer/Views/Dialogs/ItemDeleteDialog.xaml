<Window x:Class="TKer.Views.Dialogs.ItemDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="アイテム削除" Width="460"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="アイテム削除"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <StackPanel Grid.Row="1" Margin="28,20,28,24">

            <!-- アイコン + タイトル -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="❓" FontSize="22"
                           Foreground="#0B6E99"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="ItemNameText"
                           FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="15"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <!-- メッセージ -->
            <TextBlock x:Name="MessageText" Text="このアイテムを削除しますか？"
                       FontFamily="Yu Gothic UI" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- ファイル削除トグル（ファイル付きアイテムごとに表示） -->
            <StackPanel x:Name="FileDeleteSection" Visibility="Collapsed" Margin="0,0,0,16">
                <DockPanel Margin="0,0,0,8">
                    <Border x:Name="MasterToggleTrack" DockPanel.Dock="Right"
                            Width="44" Height="24" CornerRadius="12"
                            Cursor="Hand" MouseLeftButtonUp="ToggleMaster_Click">
                        <Grid>
                            <Border x:Name="MasterToggleThumb" Width="20" Height="20" CornerRadius="10"
                                    Background="White" HorizontalAlignment="Left"
                                    Margin="2,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="ファイルもすべて削除する"
                               FontFamily="Yu Gothic UI" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FileTogglesPanel"/>
                </ScrollViewer>
            </StackPanel>

            <!-- ボタン -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,6" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="削除"
                        Style="{StaticResource DangerFilledButton}"
                        Padding="20,6"
                        Click="Delete_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

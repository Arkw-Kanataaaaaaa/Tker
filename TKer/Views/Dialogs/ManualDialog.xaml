<Window x:Class="TKer.Views.Dialogs.ManualDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="操作マニュアル — TKer"
        Height="720" Width="780"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="4"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 目次 -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="目次" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextDimBrush}"
                               Margin="16,0,0,8"/>
                    <ListBox x:Name="TocList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="TocList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="16,9"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1F3D7EFF"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.HouseFill}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="ホーム画面" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="プロジェクト作成" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.ArrowClockwise}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="複数プロジェクト" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="カテゴリー管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.CheckCircleFill}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="タスク管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="フォルダ管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.BarChartFill}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="ガントチャート" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.Calendar3}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="カレンダー" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Bi.QuestionCircleFill}" Style="{StaticResource BiIconSm}" Margin="0,0,7,0"/>
                                <TextBlock Text="よくある質問" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 本文 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" x:Name="ContentScroll"
                              Padding="28,20" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel"/>
                </ScrollViewer>
                <Border Grid.Row="1" Padding="16,10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Button Content="閉じる" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

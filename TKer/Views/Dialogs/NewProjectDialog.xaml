<Window x:Class="TKer.Views.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="新規プロジェクト作成" Width="480" Height="340"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,20">

                <!-- プロジェクト名 -->
                <TextBlock Text="プロジェクト名 *" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                <!-- 説明 -->
                <TextBlock Text="説明（任意）" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDesc" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                <!-- 保存先フォルダ -->
                <TextBlock Text="保存先フォルダ *" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPath" Style="{StaticResource DarkTextBox}"
                             IsReadOnly="True" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" x:Name="BtnBrowse"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,5" Click="BtnBrowse_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,4,0"/>
                            <TextBlock Text="参照" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- フッター -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                        Padding="14,8" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="作成" Style="{StaticResource PrimaryButton}"
                        Padding="24,8" Click="BtnOk_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="TKer.Views.Dialogs.ScheduleEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="イベント編集" Width="460" Height="520"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgCardBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー（標準パターン） -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <!-- タイトル -->
                <TextBlock Text="タイトル *" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTitle" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                <!-- 終日 -->
                <CheckBox x:Name="ChkAllDay" Content="終日" Style="{StaticResource DarkCheckBox}"
                          Margin="0,0,0,14" Checked="ChkAllDay_Changed" Unchecked="ChkAllDay_Changed"/>

                <!-- 開始日時 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="開始日" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpStart" Style="{StaticResource DarkDatePicker}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0" x:Name="TimeStartPanel">
                        <TextBlock Text="開始時刻" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStartTime" Style="{StaticResource DarkTextBox}" Text="09:00"/>
                    </StackPanel>
                </Grid>

                <!-- 終了日時 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="終了日" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpEnd" Style="{StaticResource DarkDatePicker}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0" x:Name="TimeEndPanel">
                        <TextBlock Text="終了時刻" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEndTime" Style="{StaticResource DarkTextBox}" Text="10:00"/>
                    </StackPanel>
                </Grid>

                <!-- 場所 -->
                <TextBlock Text="場所（任意）" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtLocation" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                <!-- 説明 -->
                <TextBlock Text="説明（任意）" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDesc" Style="{StaticResource DarkTextBox}"
                         AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                <!-- カラー -->
                <TextBlock Text="カラー" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                <WrapPanel Margin="0,0,0,20">
                    <RadioButton x:Name="RbBlue"   GroupName="Color" Tag="#2383E2" Margin="0,0,8,4" Checked="Color_Checked">
                        <Ellipse Width="24" Height="24" Fill="#2383E2"/>
                    </RadioButton>
                    <RadioButton x:Name="RbCyan"   GroupName="Color" Tag="#26A69A" Margin="0,0,8,4" Checked="Color_Checked">
                        <Ellipse Width="24" Height="24" Fill="#26A69A"/>
                    </RadioButton>
                    <RadioButton x:Name="RbGreen"  GroupName="Color" Tag="#388E3C" Margin="0,0,8,4" Checked="Color_Checked">
                        <Ellipse Width="24" Height="24" Fill="#388E3C"/>
                    </RadioButton>
                    <RadioButton x:Name="RbOrange" GroupName="Color" Tag="#F57C00" Margin="0,0,8,4" Checked="Color_Checked">
                        <Ellipse Width="24" Height="24" Fill="#F57C00"/>
                    </RadioButton>
                    <RadioButton x:Name="RbRed"    GroupName="Color" Tag="#C62828" Margin="0,0,8,4" Checked="Color_Checked">
                        <Ellipse Width="24" Height="24" Fill="#C62828"/>
                    </RadioButton>
                    <RadioButton x:Name="RbPurple" GroupName="Color" Tag="#6A1B9A" Margin="0,0,8,4" Checked="Color_Checked">
                        <Ellipse Width="24" Height="24" Fill="#6A1B9A"/>
                    </RadioButton>
                </WrapPanel>

                <!-- ボタン（標準パターン：右揃え StackPanel） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                            Padding="16,8" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnOk" Content="保存" Style="{StaticResource PrimaryButton}"
                            Padding="24,8" Click="BtnOk_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

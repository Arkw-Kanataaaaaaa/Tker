<Window x:Class="TKer.Views.Dialogs.TaskDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="タスクの削除" Height="300" Width="440"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Path Data="{StaticResource Bi.Trash3}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource AccentRedBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="タスクを削除しますか？"
                               FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TaskNameBlock" FontSize="13"
                           Foreground="{StaticResource AccentCyanBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" Content="キャンセル" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                    <Button Margin="0,0,8,0" Content="フォルダも削除" Style="{StaticResource DangerButton}"
                            Click="DeleteWithFolder_Click"/>
                    <Button Margin="0,0,8,0" Content="データのみ削除" Style="{StaticResource PrimaryButton}"
                            Click="DeleteDataOnly_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<Window x:Class="TKer.Views.Dialogs.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="タスク追加" Height="520" Width="560"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="4"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin"     Value="0,4,0,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" Padding="28,20,28,20"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- カテゴリー -->
                <TextBlock Text="カテゴリー *" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="CbCategory" Style="{StaticResource DarkComboBox}"
                          Margin="0,0,0,14" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <!-- タスク名 -->
                <TextBlock Text="タスク名 *" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,14" Tag="タスク名を入力"/>

                <!-- タスク名省略形 -->
                <TextBlock Text="タスク名(省略形) ※フォルダ名に使用" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtNameShort" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,14" Tag="20文字以内"/>

                <!-- 中分類・環境 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="タスク中分類" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtSubCategory" Style="{StaticResource DarkTextBox}"
                                 Tag="例: 機能１"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="環境" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtEnvironment" Style="{StaticResource DarkTextBox}"
                                 Tag="例: 開発 / 検証 / 本番"/>
                    </StackPanel>
                </Grid>

                <!-- 担当者・優先度・ステータス -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="担当者" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtAssignee" Style="{StaticResource DarkTextBox}"
                                 Tag="担当者名"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="優先度" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="CbPriority" Style="{StaticResource DarkComboBox}">
                            <ComboBoxItem Content="高"/>
                            <ComboBoxItem Content="中" IsSelected="True"/>
                            <ComboBoxItem Content="低"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="ステータス" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="CbStatus" Style="{StaticResource DarkComboBox}">
                            <ComboBoxItem Content="未着手" IsSelected="True"/>
                            <ComboBoxItem Content="対応中"/>
                            <ComboBoxItem x:Name="CbStatusReview" Content="レビュー中"/>
                            <ComboBoxItem Content="完了"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- 予定期間 -->
                <TextBlock Text="予定期間" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="開始日 (予定)" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="DpPlanStart" Style="{StaticResource DarkDatePicker}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="終了日 (予定)" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="DpPlanEnd" Style="{StaticResource DarkDatePicker}"/>
                    </StackPanel>
                </Grid>

                <!-- タグ・遅延承認 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="タグ (カンマ区切り)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtTags" Style="{StaticResource DarkTextBox}"
                                 Tag="設計, 開発, レビュー"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <CheckBox x:Name="ChkDelayApproved"
                                  Content="遅延承認済み (アラート抑制)"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- 説明 -->
                <TextBlock Text="説明" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtDescription" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,14" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- 備考 -->
                <TextBlock Text="備考" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="TxtNotes" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,20" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- フッター -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" Content="キャンセル"
                            Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                    <Button Content="保存"
                            Style="{StaticResource PrimaryButton}" Click="OK_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

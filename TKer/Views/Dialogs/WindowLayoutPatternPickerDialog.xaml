<Window x:Class="TKer.Views.Dialogs.WindowLayoutPatternPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="レイアウトパターン選択"
        Width="720" Height="640"
        Background="{StaticResource BgCardBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="44" Height="36"
                        Style="{StaticResource WinCloseBtn}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <TextBlock Text="レイアウトパターン選択"
                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="1" Margin="28,20,28,12">
            <TextBlock Text="使うレイアウトを選択"
                       FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="次の画面で各ゾーンに配置するアプリを設定します"
                       FontFamily="Yu Gothic UI" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 9パターン 3x3 グリッド -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
            <UniformGrid x:Name="PatternGrid" Rows="3" Columns="3"/>
        </ScrollViewer>

        <!-- 閉じる -->
        <Border Grid.Row="3" Padding="20,12,20,20">
            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                    Padding="22,6" HorizontalAlignment="Right"
                    IsCancel="True" Click="Cancel_Click"/>
        </Border>
    </Grid>
</Window>

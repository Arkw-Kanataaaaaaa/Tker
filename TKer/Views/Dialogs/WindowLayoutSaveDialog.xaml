<Window x:Class="TKer.Views.Dialogs.WindowLayoutSaveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ウィンドウレイアウト"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgSecondaryBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="名前" Foreground="{DynamicResource TextPrimaryBrush}"
                   FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtName" Padding="6" FontSize="13" Margin="0,0,0,14"/>

        <TextBlock Text="説明" Foreground="{DynamicResource TextPrimaryBrush}"
                   FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtDescription" Padding="6" Height="90"
                 FontSize="12"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" Width="90" Padding="0,5" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存" Width="90" Padding="0,5"
                    IsDefault="True" Click="Save_Click"
                    Background="{DynamicResource AccentCyanBrush}"
                    Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="TKer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TKer.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TKer" Height="820" Width="1320"
        MinHeight="620" MinWidth="960"
        Background="{StaticResource BgPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <!-- 背景画像レイヤー -->
        <Image x:Name="BgImageElement" Stretch="UniformToFill" Opacity="0"
               Grid.RowSpan="3" Panel.ZIndex="-1" IsHitTestVisible="False"/>

        <!-- 背景動画レイヤー -->
        <MediaElement x:Name="BgVideoElement" Stretch="UniformToFill" Opacity="0"
                      Grid.RowSpan="3" Panel.ZIndex="-1" IsHitTestVisible="False"
                      LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      Volume="0" IsMuted="True"/>

        <!-- ═══════════════════════════════════════ TOP TOOLBAR -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">

                <!-- ロゴ -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,16,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="False">
                    <TextBlock Text="TKer"
                               FontFamily="Yu Gothic UI" FontWeight="Black" FontSize="16"
                               Foreground="{StaticResource AccentCyanBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ウィンドウ操作ボタン（最右端） -->
                <!-- Margin 右=-12 は DockPanel の右マージン(12)を相殺してウィンドウ端に揃える -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Stretch" Margin="4,0,-12,0">
                    <Button x:Name="BtnMinimize" Width="44" Height="48"
                            Style="{StaticResource WinCtrlBtn}"
                            Click="WinMinimize_Click" ToolTip="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIcon}"
                              Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Width="44" Height="48"
                            Style="{StaticResource WinCtrlBtn}"
                            Click="WinMaximize_Click" ToolTip="最大化/元のサイズ"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="MaximizeIcon"
                              Data="{StaticResource Bi.Square}" Style="{StaticResource BiIcon}"
                              Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                    <Button x:Name="BtnClose" Width="44" Height="48"
                            Style="{StaticResource WinCloseBtn}"
                            Click="WinClose_Click" ToolTip="閉じる"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIcon}"
                              Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>

                <!-- 右側アクション -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- 再生中メディア（システム）— 何も再生していなければ非表示 -->
                    <Border x:Name="MediaPanel" Width="200" Height="24"
                            CornerRadius="11" Margin="0,0,12,0"
                            ClipToBounds="True" Visibility="Collapsed"
                            Cursor="Hand" MouseLeftButtonUp="MediaPanel_Click">
                        <DockPanel LastChildFill="True">
                            <!-- 左端：再生中アプリのアイコン（原色そのまま / 代替は白音符） -->
                            <Grid DockPanel.Dock="Left" Width="26">
                                <Image x:Name="AppIconImage" Width="16" Height="16"
                                       Stretch="Uniform" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="AppIconFallback"
                                      Data="{StaticResource Bi.MusicNoteBeamed}"
                                      Fill="White" Stretch="Uniform" Width="13" Height="13"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="3"
                                                          ShadowDepth="0" Opacity="0.5"/>
                                    </Path.Effect>
                                </Path>
                            </Grid>
                            <!-- 残り：流れるタイトル（自然幅でレンダリングしクリップ領域内を移動） -->
                            <Canvas x:Name="MarqueeCanvas" ClipToBounds="True">
                                <TextBlock x:Name="MediaTrackName" Text="---" Canvas.Top="4"
                                           Foreground="White"
                                           FontFamily="Yu Gothic UI" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="3"
                                                          ShadowDepth="0" Opacity="0.6"/>
                                    </TextBlock.Effect>
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="MarqueeTransform" X="4"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </DockPanel>
                    </Border>

                    <!-- Now Playing ポップアップ -->
                    <Popup x:Name="MediaPopup"
                           PlacementTarget="{Binding ElementName=MediaPanel}"
                           Placement="Bottom" VerticalOffset="6" HorizontalOffset="0"
                           StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="None" Closed="MediaPopup_Closed">
                        <Border x:Name="PopupRoot" Width="320" CornerRadius="16"
                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                RenderTransformOrigin="0,0" SizeChanged="PopupRoot_SizeChanged">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PopupScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18"
                                                  ShadowDepth="3" Opacity="0.55"/>
                            </Border.Effect>
                            <Border.Resources>
                                <!-- ポップアップ用の透明丸ボタン -->
                                <Style x:Key="PopupCtrlBtn" TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="22"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Resources>

                            <Grid>
                                <!-- 背景：サムネイルをぼかしたもの -->
                                <Image x:Name="PopupBgImage" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <BlurEffect Radius="45" KernelType="Gaussian"/>
                                    </Image.Effect>
                                </Image>
                                <!-- 可読性のための暗いスクリム -->
                                <Border Background="#A8000000"/>

                                <StackPanel Margin="18,16,18,10">
                                    <!-- タイトル行：左上にアプリアイコン -->
                                    <DockPanel>
                                        <Image x:Name="PopupAppIcon" DockPanel.Dock="Left"
                                               Width="34" Height="34" Stretch="Uniform"
                                               VerticalAlignment="Top" Margin="0,0,12,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="PopupTitle" Text="---"
                                                       Foreground="White"
                                                       FontFamily="Yu Gothic UI" FontSize="14" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="PopupSubtitle" Text=""
                                                       Foreground="#CCFFFFFF"
                                                       FontFamily="Yu Gothic UI" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- 再生時間バー（クリックでシーク） -->
                                    <Grid x:Name="ProgressTrack" Height="6" Margin="0,16,0,0"
                                          Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="ProgressTrack_Click">
                                        <Border Height="4" CornerRadius="2"
                                                Background="#40FFFFFF" VerticalAlignment="Center"/>
                                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2"
                                                Background="White" Width="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 時間表示：左=現在 / 右=全体 -->
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock x:Name="PopupCurTime" DockPanel.Dock="Left"
                                                   Text="0:00" Foreground="#CCFFFFFF"
                                                   FontFamily="Consolas" FontSize="10"/>
                                        <TextBlock x:Name="PopupTotTime" DockPanel.Dock="Right"
                                                   Text="0:00" Foreground="#CCFFFFFF"
                                                   FontFamily="Consolas" FontSize="10"
                                                   HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <!-- 操作：前 / 再生・一時停止 / 次 -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" Margin="0,14,0,0">
                                        <Button Style="{StaticResource PopupCtrlBtn}"
                                                Padding="9" ToolTip="前のトラック"
                                                Click="MediaPrev_Click">
                                            <Path Data="{StaticResource Bi.SkipStartFill}"
                                                  Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource PopupCtrlBtn}"
                                                Padding="12" Margin="10,0" ToolTip="再生 / 一時停止"
                                                Click="MediaPlayPause_Click">
                                            <Path x:Name="PopupPlayIcon"
                                                  Data="{StaticResource Bi.PlayFill}"
                                                  Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                                        </Button>
                                        <Button Style="{StaticResource PopupCtrlBtn}"
                                                Padding="9" ToolTip="次のトラック"
                                                Click="MediaNext_Click">
                                            <Path Data="{StaticResource Bi.SkipEndFill}"
                                                  Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Popup>

                    <TextBlock Text="{Binding ProjectTitle}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                    <Button Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"
                            Padding="8,4" FontSize="12"
                            Command="{Binding ShowAlertsCommand}"
                            Visibility="{Binding AlertCount,
                                Converter={StaticResource IntToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.BellFill}" Style="{StaticResource BiIconSm}"
                                  Fill="{StaticResource AccentYellowBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding AlertCount}"
                                       FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="{StaticResource AccentRedBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Padding="10,4" FontSize="12"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsProjectLoaded}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.Floppy}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,5,0"/>
                            <TextBlock Text="保存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ナビゲーションメニュー -->
                <Menu x:Name="TopMenu" VerticalAlignment="Center"
                      Style="{StaticResource TopMenuStyle}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">

                    <MenuItem Style="{StaticResource TopMenuItemStyle}"
                              Tag="ホーム"
                              Command="{Binding NavigateToCommand}"
                              CommandParameter="Home">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Bi.HouseFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                <TextBlock Text="ホーム" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>

                    <MenuItem Style="{StaticResource TopMenuItemStyle}"
                              Tag="ライブラリ">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                <TextBlock Text="ライブラリ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Style="{StaticResource SubParentMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="プロジェクト" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Command="{Binding NavigateToCommand}"
                                      CommandParameter="ProjectList">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.ClipboardFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="一覧" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Click="ProjectLoad_Click">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="読み込み" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Click="ProjectAdd_Click">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="追加" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubParentMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.BookFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="コレクション" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Command="{Binding NavigateToCommand}"
                                      CommandParameter="Collection">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.ClipboardFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="一覧" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Click="CollectionLoad_Click">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="読み込み" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Click="CollectionAdd_Click">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="追加" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Style="{StaticResource TopMenuItemStyle}"
                              Tag="タスク管理"
                              IsEnabled="{Binding IsProjectLoaded}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Bi.CheckCircleFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                <TextBlock Text="タスク" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Style="{StaticResource SubParentMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.CheckCircleFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="タスク" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Command="{Binding NavigateToCommand}"
                                      CommandParameter="TaskList">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.ClipboardFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="一覧" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Click="MenuNewTask_Click">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="新規作成" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Click="MenuNewCategory_Click">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="カテゴリー追加" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator Style="{StaticResource DarkMenuSeparator}"/>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Click="MenuExportCsv_Click"
                                      IsEnabled="{Binding IsProjectLoaded}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.BoxArrowUp}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="CSV出力" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                      Click="MenuExportWbs_Click"
                                      IsEnabled="{Binding IsProjectLoaded}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Bi.FileEarmarkSpreadsheet}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                        <TextBlock Text="Excel出力" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Command="{Binding NavigateToCommand}"
                                  CommandParameter="Todo">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="TODO" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Command="{Binding NavigateToCommand}"
                                  CommandParameter="Calendar">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.Calendar3}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="カレンダー" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Command="{Binding NavigateToCommand}"
                                  CommandParameter="Dashboard">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.BarChartFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="ダッシュボード" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Style="{StaticResource TopMenuItemStyle}"
                              Tag="ツール">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Bi.Tools}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                <TextBlock Text="ツール" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <Separator Style="{StaticResource DarkMenuSeparator}"/>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Command="{Binding NavigateToCommand}"
                                  CommandParameter="Pomodoro">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.BellFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="ポモドーロ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Command="{Binding NavigateToCommand}"
                                  CommandParameter="Article">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="記事作成" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Click="MenuBookmarkWidget_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔖" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="栞ウィジェット" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <Separator Style="{StaticResource DarkMenuSeparator}"/>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Click="MenuLaunchWidgetProcess_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖥" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ウィジェットを別プロセスで起動" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Style="{StaticResource TopMenuItemStyle}"
                              Tag="カスタマイズ">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Bi.GearFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                <TextBlock Text="カスタマイズ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Click="AppSettings_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.GearFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="詳細設定" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Command="{Binding NavigateToCommand}"
                                  CommandParameter="UiCustomize">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.LayoutTextWindow}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="UIカスタマイズ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Style="{StaticResource TopMenuItemStyle}"
                              Tag="ヘルプ">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Bi.QuestionCircleFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                <TextBlock Text="ヘルプ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Click="MenuAbout_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Bi.InfoCircleFill}" Style="{StaticResource BiIconSm}" Margin="0,0,5,0"/>
                                    <TextBlock Text="バージョン情報" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Click="MenuChangelog_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="リリースノート" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Click="MenuManual_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📖" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="マニュアル" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <Separator Style="{StaticResource DarkMenuSeparator}"/>
                        <MenuItem Style="{StaticResource SubMenuItemStyle}"
                                  Command="{Binding NavigateToCommand}"
                                  CommandParameter="LogViewer">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📜" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ログビューアー" VerticalAlignment="Center"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>

                </Menu>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════ CONTENT -->
        <Frame Grid.Row="1" x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>

        <!-- フォルダ操作エラートースト -->
        <Border Grid.Row="1" x:Name="FolderOpToast"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,16,0" Padding="14,10"
                Background="#EE1A1A2E" CornerRadius="8"
                BorderBrush="#CC6B2E2E" BorderThickness="1"
                Visibility="{Binding HasFolderOpError, Converter={StaticResource BoolVis}}"
                Panel.ZIndex="150" MaxWidth="380">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Bi.ExclamationTriangleFill}" Style="{StaticResource BiIconSm}"
                      Fill="{StaticResource AccentRedBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding FolderOpError}" FontSize="12"
                           Foreground="White" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ファイル変更通知トースト（進捗反映タグ） -->
        <Border Grid.Row="1" x:Name="FileChangeToast"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16" Padding="14,10"
                Background="#EE0E1E2E" CornerRadius="8"
                BorderBrush="#CC2383E2" BorderThickness="1"
                Visibility="{Binding HasFileChangeNotification, Converter={StaticResource BoolVis}}"
                Panel.ZIndex="150" MaxWidth="360" Cursor="Hand"
                MouseLeftButtonUp="FileChangeToast_Click">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Path Data="{StaticResource Bi.FileEarmarkText}" Style="{StaticResource BiIconSm}"
                          Fill="{StaticResource AccentCyanBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="ファイルが変更されました" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding FileChangeTaskName}" FontSize="12"
                           Foreground="White" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="クリックして進捗を更新 →" FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════ LOADING OVERLAY -->
        <!-- タイトルバー以外を薄白で覆うローディングオーバーレイ -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="1" Grid.RowSpan="2"
                Background="#40FFFFFF"
                Opacity="0" Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="200">
            <Image Source="/Resources/now_loading.png"
                   Width="600" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.55"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <!-- ═══════════════════════════════════════ STATUS BAR -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <!-- 右端: フォルダキュー処理中インジケーター -->
                <Border DockPanel.Dock="Right"
                        Visibility="{Binding IsFolderQueueBusy, Converter={StaticResource BoolVis}}"
                        Background="#1A2383E2" CornerRadius="3" Padding="8,1" Margin="0,3,0,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳ " FontSize="11"
                                   Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="フォルダ操作処理中" FontSize="11"
                                   Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" (" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FolderQueueCount}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="件)" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- 左: ステータスメッセージ -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>

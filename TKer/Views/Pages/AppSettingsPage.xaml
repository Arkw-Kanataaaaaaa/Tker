<Page x:Class="TKer.Views.Pages.AppSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Yu Gothic UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Yu Gothic UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource AccentCyanBrush}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource BgSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Padding="24,12" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="詳細設定"
                       FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- メイン: サイドバー + スクロールコンテンツ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- サイドバー -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0">
                    <Button x:Name="NavBtnGeneral"   Content="一般設定"       Style="{StaticResource SideNavBtn}" Click="NavGeneral_Click"/>
                    <Button x:Name="NavBtnLog"       Content="ログ設定"       Style="{StaticResource SideNavBtn}" Click="NavLog_Click"/>
                    <Button x:Name="NavBtnShortcuts" Content="ショートカット" Style="{StaticResource SideNavBtn}" Click="NavShortcuts_Click"/>
                </StackPanel>
            </Border>

            <!-- スクロールコンテンツ -->
            <Border x:Name="ContentBorder" Grid.Column="1">
            <ScrollViewer x:Name="SettingsScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentPanel" Margin="32,24,32,24" MaxWidth="560">

                    <!-- ══ 一般設定 ══ -->
                    <TextBlock x:Name="SecGeneral" Text="一般設定" Style="{StaticResource SectionHeading}"/>

                    <TextBlock Text="アラートの猶予日数" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="未着手超過アラートの猶予日数"
                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="TxtGraceDays" Style="{StaticResource DarkTextBox}"
                                     Width="50" Text="1"/>
                            <TextBlock Text="日" FontSize="13" Margin="6,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ChkHideCompleted"
                              Content="スケジュール画面で完了タスクをデフォルト非表示"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13" Margin="0,0,0,28"/>

                    <TextBlock Text="利用モード" Style="{StaticResource SectionHeading}" Margin="0,0,0,10"/>
                    <RadioButton x:Name="RbMultiMode" Content="複数人モード（レビュー・管理者あり）"
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                 GroupName="AppMode" Margin="0,0,0,8"/>
                    <RadioButton x:Name="RbPersonalMode" Content="個人モード（レビューなし・シンプル管理）"
                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                 GroupName="AppMode"/>
                    <TextBlock Text="※ 個人モードではステータス「レビュー中」が非表示になります"
                               FontSize="11" Foreground="{StaticResource TextDimBrush}"
                               Margin="0,6,0,28"/>

                    <TextBlock Text="背景画像" Style="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBgPath" Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True" Tag="画像未設定" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Padding="8,5" Margin="0,0,6,0"
                                    Click="BrowseBg_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                          Margin="0,0,5,0"/>
                                    <TextBlock Text="選択" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Padding="8,5"
                                    Click="ClearBg_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"
                                          Margin="0,0,5,0"/>
                                    <TextBlock Text="解除" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- テーマ・ホームカスタマイズ・ツールバーは UIカスタマイズ画面へ移動 -->
                    <Separator x:Name="_removedPlaceholder" Visibility="Collapsed"/>

                    <!-- ══ ログ設定 ══ -->
                    <TextBlock x:Name="SecLog" Text="ログ設定" Style="{StaticResource SectionHeading}"/>
                    <TextBlock Text="アプリログのローテーション動作を設定します。設定は保存時に即時反映されます。"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16,14" Margin="0,0,0,28">
                        <StackPanel>
                            <CheckBox x:Name="ChkLogEnabled"
                                      Content="ログローテーションを有効にする"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      FontSize="13" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 周期 -->
                                <TextBlock Grid.Row="0" Text="ローテーション周期"
                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CbLogPeriod"
                                          Style="{StaticResource DarkComboBox}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="日次 (daily)"   Tag="daily"/>
                                    <ComboBoxItem Content="週次 (weekly)"  Tag="weekly"/>
                                    <ComboBoxItem Content="月次 (monthly)" Tag="monthly"/>
                                    <ComboBoxItem Content="サイズ (size)"  Tag="size"/>
                                </ComboBox>

                                <!-- サイズ上限 -->
                                <TextBlock Grid.Row="1" Text="サイズ上限"
                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10"
                                            VerticalAlignment="Center">
                                    <TextBox x:Name="TxtLogMaxSizeMB" Style="{StaticResource DarkTextBox}"
                                             Width="70" Text="10"/>
                                    <TextBlock Text="MB　※ 周期が「サイズ」の場合のみ有効"
                                               FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>

                                <!-- 保持ファイル数 -->
                                <TextBlock Grid.Row="2" Text="保持するファイル数"
                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10"
                                            VerticalAlignment="Center">
                                    <TextBox x:Name="TxtLogMaxFiles" Style="{StaticResource DarkTextBox}"
                                             Width="70" Text="7"/>
                                    <TextBlock Text="個"
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>

                                <!-- ローテーション時の処理 -->
                                <TextBlock Grid.Row="3" Text="ローテーション時の処理"
                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CbLogOnRotate"
                                          Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="バックアップ (backup)" Tag="backup"/>
                                    <ComboBoxItem Content="削除 (delete)"        Tag="delete"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ══ ショートカット ══ -->
                    <TextBlock x:Name="SecShortcuts" Text="ショートカット" Style="{StaticResource SectionHeading}"/>
                    <TextBlock Text="ホーム画面のショートカットボタンを管理します"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               Margin="0,0,0,12"/>

                    <Border Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" MinHeight="60">
                        <StackPanel x:Name="ScListPanel" Margin="8"/>
                    </Border>

                    <Button Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Click="AddShortcut_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconSm}"
                                  Fill="{StaticResource AccentBlueBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="ショートカットを追加" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>


                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>

        <!-- フッター: 保存ボタン -->
        <Border Grid.Row="2" Padding="20,10" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Style="{StaticResource PrimaryButton}"
                    Padding="20,7" HorizontalAlignment="Right"
                    Click="Save_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Bi.Floppy}" Style="{StaticResource BiIconSm}"
                          Fill="White" Margin="0,0,6,0"/>
                    <TextBlock Text="保存" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</Page>

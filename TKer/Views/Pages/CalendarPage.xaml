<Page x:Class="TKer.Views.Pages.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,12" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="スケジュール" FontFamily="Yu Gothic UI" FontWeight="Bold"
                           FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                            Padding="8,5" Click="PrevMonth_Click" ToolTip="前の月">
                        <Path Data="{StaticResource Bi.ChevronLeft}" Style="{StaticResource BiIconSm}"/>
                    </Button>
                    <TextBlock x:Name="MonthLabel" FontFamily="Consolas" FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" MinWidth="120" TextAlignment="Center"/>
                    <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                            Padding="8,5" Click="NextMonth_Click" ToolTip="次の月">
                        <Path Data="{StaticResource Bi.ChevronRight}" Style="{StaticResource BiIconSm}"/>
                    </Button>
                    <Button Margin="0,0,8,0" Content="今月" Style="{StaticResource SecondaryButton}"
                            Padding="10,5" Click="Today_Click"/>
                    <!-- イベント追加 -->
                    <Button Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                            Padding="10,5" Click="BtnAddEvent_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="イベント追加" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="完了を非表示"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,5" FontSize="12" Click="ToggleCompleted_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 凡例 -->
        <Border Grid.Row="1" Padding="24,6" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#3D7EFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="予定" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#00E676" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="実績" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="10" Height="10" CornerRadius="2" Background="#FF7043" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="イベント" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- カレンダーView -->
        <Grid Grid.Row="2" x:Name="CalendarView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左: カレンダーグリッド -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 曜日ヘッダー -->
                <UniformGrid Grid.Row="0" Columns="7" Margin="16,12,16,4">
                    <TextBlock Text="日" Style="{StaticResource DayHeader}" Foreground="{StaticResource AccentRedBrush}"/>
                    <TextBlock Text="月" Style="{StaticResource DayHeader}"/>
                    <TextBlock Text="火" Style="{StaticResource DayHeader}"/>
                    <TextBlock Text="水" Style="{StaticResource DayHeader}"/>
                    <TextBlock Text="木" Style="{StaticResource DayHeader}"/>
                    <TextBlock Text="金" Style="{StaticResource DayHeader}"/>
                    <TextBlock Text="土" Style="{StaticResource DayHeader}" Foreground="{StaticResource AccentBlueBrush}"/>
                </UniformGrid>
                <!-- セルグリッド -->
                <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
                    <UniformGrid x:Name="CalGrid" Columns="7" Rows="6"/>
                </ScrollViewer>
            </Grid>

            <!-- グリップ -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE"/>

            <!-- 右: 日別詳細パネル -->
            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 日付ヘッダー -->
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="TxtSelectedDate"
                                   Text="日付を選択" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- イベント一覧 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EventListPanel" Margin="8,8,8,8"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>

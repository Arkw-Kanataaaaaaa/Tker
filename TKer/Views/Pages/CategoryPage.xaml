<Page x:Class="TKer.Views.Pages.CategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ページヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,12"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="カテゴリー一覧"
                       FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- 検索セクション（アニメーション付き） -->
        <Border x:Name="SearchSection" Grid.Row="1" Visibility="Collapsed"
                ClipToBounds="True"
                Padding="12,8" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280"
                         Style="{StaticResource DarkTextBox}"
                         Tag="カテゴリー名・説明で検索"
                         TextChanged="SearchBox_TextChanged"
                         VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ: 縦型ツールバー + 一覧 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 縦型ツールバー -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                    <Button x:Name="BtnOpenFolder" ToolTip="カテゴリーフォルダを開く (Ctrl+O)" Style="{StaticResource VToolbarBtn}"
                            Click="OpenFolder_Click" IsEnabled="False">
                        <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button x:Name="BtnEditCategory" ToolTip="カテゴリー編集 (F2)" Style="{StaticResource VToolbarBtn}"
                            Click="EditCategory_Click" IsEnabled="False">
                        <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button ToolTip="カテゴリー追加 (Ctrl+Shift+;)" Style="{StaticResource VToolbarBtn}"
                            Click="AddCategory_Click">
                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button x:Name="BtnDeleteCategory" ToolTip="カテゴリー削除 (Ctrl+-)" Style="{StaticResource VToolbarBtn}"
                            Click="DeleteCategory_Click" IsEnabled="False">
                        <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>
                    <Button x:Name="BtnMoveUp" ToolTip="優先度を上げる (Alt+↑)" Style="{StaticResource VToolbarBtn}"
                            Click="MoveUp_Click" IsEnabled="False">
                        <Path Data="{StaticResource Bi.ArrowUp}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button x:Name="BtnMoveDown" ToolTip="優先度を下げる (Alt+↓)" Style="{StaticResource VToolbarBtn}"
                            Click="MoveDown_Click" IsEnabled="False">
                        <Path Data="{StaticResource Bi.ArrowDown}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button ToolTip="検索 (Ctrl+F)" Style="{StaticResource VToolbarBtn}"
                            Click="ToggleSearch_Click">
                        <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- カテゴリー一覧 -->
            <Border x:Name="ContentBorder" Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <ItemsControl x:Name="CategoryItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" CornerRadius="10" Padding="16,14"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="CategoryCard_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- カラーバー -->
                                        <Border Grid.Column="0" CornerRadius="3,0,0,3" Margin="-16,-14,8,-14">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Cat.Color, Converter={StaticResource StringToColorConverter}}"/>
                                            </Border.Background>
                                        </Border>

                                        <!-- 情報 -->
                                        <StackPanel Grid.Column="1">
                                            <DockPanel>
                                                <TextBlock Text="{Binding OrderLabel}" FontFamily="Consolas"
                                                           FontSize="11" Foreground="{StaticResource AccentCyanBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Cat.Id}" FontFamily="Consolas"
                                                           FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Cat.Name}" FontFamily="Yu Gothic UI"
                                                           FontWeight="Bold" FontSize="16"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Cat.Description}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,4,0,8" TextWrapping="Wrap"/>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontSize="11"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           Text="{Binding Cat.CreatedAt, StringFormat='作成: {0:yyyy/MM/dd}'}"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                                          Fill="{StaticResource TextDimBrush}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding Cat.FolderPath}" FontFamily="Consolas"
                                                               FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>

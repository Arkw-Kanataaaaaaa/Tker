<Page x:Class="TKer.Views.Pages.CollectionItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── ページヘッダー ─── -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,12">
            <DockPanel>
                <!-- 右: アイテム数バッジ -->
                <TextBlock x:Name="TxtItemCount" DockPanel.Dock="Right"
                           FontSize="13" Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>

                <!-- 左: 戻るボタン + アイコン + 名前 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource VToolbarBtn}" ToolTip="コレクション一覧へ戻る"
                            Click="Back_Click" Margin="0,0,8,0">
                        <Path Data="{StaticResource Bi.ChevronLeft}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <TextBlock x:Name="TxtHeaderIcon" FontSize="20" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtHeaderName" FontWeight="Bold" FontSize="18"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ─── メイン Grid ─── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── 縦ツールバー ─── -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                    <Button x:Name="BtnAdd" Style="{StaticResource VToolbarBtn}"
                            ToolTip="アイテムを追加" Click="AddItem_Click">
                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button x:Name="BtnEdit" Style="{StaticResource VToolbarBtn}"
                            ToolTip="選択したアイテムを編集" Click="EditItem_Click" Opacity="0.35">
                        <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button x:Name="BtnDelete" Style="{StaticResource VToolbarBtn}"
                            ToolTip="選択したアイテムを削除" Click="DeleteItem_Click" Opacity="0.35">
                        <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>
                    <Button Style="{StaticResource VToolbarBtn}"
                            ToolTip="フォルダを開く" Click="OrganizeFolder_Click">
                        <Path Data="{StaticResource Bi.WrenchFill}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ─── コンテンツ ─── -->
            <Grid Grid.Column="1" Background="{StaticResource BgPrimaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 列ヘッダー（コードから差し替え） -->
                <Border x:Name="ItemsListHeader" Grid.Row="0"/>

                <!-- アイテム一覧 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ItemsListPanel"/>
                </ScrollViewer>

                <!-- 空状態 -->
                <StackPanel x:Name="EmptyStatePanel" Grid.Row="1"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="48"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="アイテムがありません"
                               FontSize="15" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="「＋」ボタンから追加できます"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ─── フォームドロワー (ZIndex=10) ─── -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="10"
              x:Name="FormOverlayRoot" Visibility="Collapsed">
            <Border x:Name="FormBackdrop" Background="#40000000"
                    MouseLeftButtonUp="FormBackdrop_Click"/>
            <Border x:Name="FormOverlay" HorizontalAlignment="Right" Width="480"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    ClipToBounds="True">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FormPanelTransform"/>
                </Border.RenderTransform>
                <DockPanel>
                    <!-- ヘッダー -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                    Click="CancelForm_Click" ToolTip="閉じる">
                                <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                            </Button>
                            <TextBlock x:Name="TxtFormTitle" Text="アイテムを追加"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <!-- フッター -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="20,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Click="CancelForm_Click"/>
                            <Button x:Name="BtnFormSave" Content="追加"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="22,6" Click="SaveForm_Click"/>
                        </StackPanel>
                    </Border>
                    <!-- フォーム本体（コードで動的生成） -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FormContentPanel" Margin="24,16,24,16"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Page>

<Page x:Class="TKer.Views.Pages.CollectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <!-- アイテム形式トグル用 RadioButton -->
        <Style x:Key="ItemFormatRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource AccentCyanBrush}"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentCyanColor}" Opacity="0.12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource BgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ページヘッダー -->
        <Border Grid.Row="0" Padding="24,12" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- グリッド/リスト切替ボタン -->
                <Border x:Name="BtnViewToggle" DockPanel.Dock="Right"
                        Width="30" Height="30" CornerRadius="6" Cursor="Hand"
                        MouseLeftButtonUp="ToggleViewMode_Click" ToolTip="リスト表示に切り替え"
                        VerticalAlignment="Center" Margin="0,0,4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Background="Transparent">
                        <Path x:Name="ViewIconGrid" Data="{StaticResource Bi.Grid3x3Gap}" Style="{StaticResource BiIconLg}"/>
                        <Path x:Name="ViewIconList" Data="{StaticResource Bi.ListUl}" Style="{StaticResource BiIconLg}"
                              Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <!-- ソートボタン + ラベル -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border x:Name="BtnSortToggle"
                            Width="30" Height="30" CornerRadius="6" Cursor="Hand"
                            MouseLeftButtonUp="SortButton_Click" ToolTip="ソート順を変更">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Background="Transparent">
                            <Path Data="{StaticResource Bi.ArrowDownUp}" Style="{StaticResource BiIconLg}"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SortModeLabel" Text="更新日時 ↓" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Background="Transparent" Cursor="Hand"
                               ToolTip="昇順／降順を切り替え"
                               MouseLeftButtonUp="ToggleSortDirection_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="コレクション"
                               FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- メインエリア（縦ツールバー + コンテンツ + ドロワー） -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ─── 縦ツールバー ─── -->
        <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                <Button x:Name="BtnToolbarEdit" Style="{StaticResource VToolbarBtn}"
                        ToolTip="コレクション編集 (F2)" Click="EditCollection_Click">
                    <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconLg}"/>
                </Button>
                <Button Style="{StaticResource VToolbarBtn}"
                        ToolTip="新規コレクション (Ctrl+Shift+;)" Click="NewCollection_Click">
                    <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                </Button>
                <Button x:Name="BtnToolbarDelete" Style="{StaticResource VToolbarBtn}"
                        ToolTip="コレクション削除 (Ctrl+-)" Click="DeleteCollection_Click">
                    <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                </Button>
                <Button Style="{StaticResource VToolbarBtn}"
                        ToolTip="コレクション読み込み (Ctrl+O)" Click="LoadCollection_Click">
                    <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconLg}"/>
                </Button>
                <Button x:Name="BtnToolbarOpen" Style="{StaticResource VToolbarBtn}"
                        ToolTip="コレクションを開く (Ctrl+A)" Click="OpenCollection_Click"
                        IsEnabled="False">
                    <Path Data="{StaticResource Bi.BookFill}" Style="{StaticResource BiIconLg}"/>
                </Button>
                <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>
                <Button x:Name="BtnToolbarSearch" Style="{StaticResource VToolbarBtn}"
                        ToolTip="検索 (Ctrl+F)" Click="ToggleSearch_Click">
                    <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconLg}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ─── メインコンテンツ ─── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 検索バー（ヘッダー下・右寄せ） -->
            <Border x:Name="SearchSection" Grid.Row="0" Visibility="Collapsed"
                    HorizontalAlignment="Right" Margin="0,6,12,6"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconSm}"
                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Width="260"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource AccentCyanBrush}"
                             FontSize="13" VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- コンテンツエリア -->
            <Grid Grid.Row="1">

                <!-- グリッド表示 -->
                <ScrollViewer x:Name="GridScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,8,8,8">
                    <WrapPanel x:Name="CollectionGridControl" Margin="4,4,4,4"/>
                </ScrollViewer>

                <!-- リスト表示 -->
                <Grid x:Name="CollectionListSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- リストヘッダー -->
                    <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="16,8,16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="コレクション名" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="アイテム形式" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="作成日時" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="3" Text="更新日時" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold"
                                       HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>

                    <!-- リストアイテム -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CollectionListPanel"/>
                    </ScrollViewer>
                </Grid>

                <!-- 空状態 -->
                <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="56"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="コレクションがありません"
                               FontSize="15" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="ツールバーの「＋」から作成できます"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ─── 右ドロワー（プッシュ型） ─── -->
        <Border x:Name="DrawerContainer" Grid.Column="2" Width="0" ClipToBounds="True"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>

                <!-- 詳細パネル (500px) -->
                <DockPanel x:Name="DetailDrawer" Width="500" HorizontalAlignment="Left"
                           Visibility="Collapsed">
                    <!-- ヘッダー -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                    Click="CloseDetailPanel_Click" ToolTip="閉じる">
                                <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                            </Button>
                            <TextBlock x:Name="TxtDetailName"
                                       FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <!-- コンテンツ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailContentPanel" Margin="24,20,24,24"/>
                    </ScrollViewer>
                </DockPanel>

                <!-- フォームパネル (500px) -->
                <DockPanel x:Name="FormDrawer" Width="500" HorizontalAlignment="Left"
                           Visibility="Collapsed">
                    <!-- フォームヘッダー -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                    Click="CancelForm_Click" ToolTip="閉じる">
                                <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                            </Button>
                            <TextBlock x:Name="TxtFormTitle" Text="新規コレクション"
                                       FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <!-- フォームフッター -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="20,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Click="CancelForm_Click"/>
                            <Button x:Name="BtnFormSave" Content="作成"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="22,6" Click="SaveForm_Click"/>
                        </StackPanel>
                    </Border>
                    <!-- フォーム本体 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20,24,20">

                            <!-- コレクション名 -->
                            <TextBlock Text="コレクション名 *" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtFormName"
                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>

                            <!-- 表紙画像 -->
                            <TextBlock Text="表紙画像" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Border x:Name="CoverImagePreviewBorder" Height="160" CornerRadius="6"
                                    Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,8" ClipToBounds="True" Cursor="Hand"
                                    AllowDrop="True"
                                    MouseLeftButtonUp="CoverImageArea_Click"
                                    DragEnter="CoverImage_DragEnter" DragOver="CoverImage_DragOver"
                                    DragLeave="CoverImage_DragLeave" Drop="CoverImage_Drop">
                                <Grid>
                                    <TextBlock x:Name="CoverImagePlaceholder"
                                               Text="クリック、またはドラッグ＆ドロップで画像を選択"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                                    <Image x:Name="CoverImagePreview" Stretch="UniformToFill"
                                           Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button x:Name="BtnClearCoverImage" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        Click="ClearCoverImage_Click" Visibility="Collapsed">
                                    <TextBlock Text="クリア"/>
                                </Button>
                            </StackPanel>

                            <!-- 説明 -->
                            <TextBlock Text="説明" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtFormDesc"
                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>

                            <!-- アイテム形式 -->
                            <TextBlock Text="アイテム形式" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <RadioButton x:Name="RbItemText"
                                             GroupName="ItemFormat" IsChecked="True"
                                             Style="{StaticResource ItemFormatRadio}"
                                             Margin="0,0,10,0"
                                             Checked="ItemFormat_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝" FontSize="14" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="文字列" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbItemFile"
                                             GroupName="ItemFormat"
                                             Style="{StaticResource ItemFormatRadio}"
                                             Checked="ItemFormat_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" FontSize="14" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="ファイル指定" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- 保存先フォルダ（ファイル指定時のみ） -->
                            <StackPanel x:Name="FolderSection" Visibility="Collapsed" Margin="0,0,0,16">
                                <TextBlock Text="保存先フォルダ *" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtFormFolder" Grid.Column="0"
                                             Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" Margin="6,0,0,0"
                                            Click="BrowseFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                                  Margin="0,0,4,0"/>
                                            <TextBlock Text="参照" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,18"/>

                            <!-- データ付属情報 -->
                            <TextBlock Text="データ付属情報" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="アイテムに付属させる情報フィールドを定義します"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,0,0,14"/>

                            <StackPanel x:Name="FormFieldListPanel" Margin="0,0,0,10"/>

                            <Border Background="{StaticResource BgSecondaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="フィールドを追加" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="付属情報名" FontSize="11"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtNewFieldName"
                                                     Style="{StaticResource DarkTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="データ形式" FontSize="11"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CbFieldType"
                                                      Style="{StaticResource DarkComboBox}"
                                                      SelectedIndex="0">
                                                <ComboBoxItem Tag="文字列">📝 文字列</ComboBoxItem>
                                                <ComboBoxItem x:Name="CbFieldFile" Tag="ファイル">📁 ファイル</ComboBoxItem>
                                                <ComboBoxItem Tag="リンク">🔗 リンク</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="＋ フィールドを追加"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,5" Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Click="AddFormField_Click"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ─── 画像プレビュー オーバーレイ ─── -->
                <Grid x:Name="PreviewOverlay" Panel.ZIndex="1000"
                      Visibility="Collapsed" Background="#DC000000"
                      MouseWheel="PreviewOverlay_MouseWheel"
                      MouseLeftButtonDown="PreviewOverlay_MouseDown"
                      MouseMove="PreviewOverlay_MouseMove"
                      MouseLeftButtonUp="PreviewOverlay_MouseUp">
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           MaxWidth="1200" MaxHeight="800"
                           RenderTransformOrigin="0.5,0.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="×" FontSize="26" FontWeight="Bold" Foreground="White" Cursor="Hand"
                               Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,8,16,0" MouseLeftButtonUp="ClosePreview_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                Margin="16,0,0,16">
                        <Border x:Name="ZoomTrack" Width="160" Height="16" Background="Transparent" Cursor="Hand"
                                VerticalAlignment="Center"
                                MouseLeftButtonDown="ZoomTrack_MouseDown"
                                MouseMove="ZoomTrack_MouseMove"
                                MouseLeftButtonUp="ZoomTrack_MouseUp">
                            <Grid>
                                <Border Height="6" CornerRadius="3" Background="#55FFFFFF" VerticalAlignment="Center"/>
                                <Border x:Name="PreviewZoomFill" Height="6" Width="0" CornerRadius="3"
                                        Background="{StaticResource AccentCyanBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Ellipse x:Name="ZoomThumb" Width="14" Height="14" Fill="White"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewZoomLabel" Text="0%" FontSize="11" Foreground="White"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>

            </Grid>

        </Border>

        </Grid>

        <!-- ソート選択ポップアップ -->
        <Popup x:Name="SortPopup" StaysOpen="False" Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnSortToggle}"
               AllowsTransparency="True">
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="4" MinWidth="150">
                <StackPanel>
                    <Border x:Name="SortOptName" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="SortByName_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortOptNameText" Text="コレクション名" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border x:Name="SortOptCreated" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="SortByCreated_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortOptCreatedText" Text="作成日時" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border x:Name="SortOptUpdated" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="SortByUpdated_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortOptUpdatedText" Text="更新日時" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="4,4,4,4"/>
                    <Border x:Name="SortDirectionRow" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="ToggleSortDirection_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortDirectionText" Text="降順 ↓" FontSize="13"
                                   Foreground="{DynamicResource AccentCyanBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</Page>

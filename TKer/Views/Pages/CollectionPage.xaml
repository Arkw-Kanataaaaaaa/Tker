<Page x:Class="TKer.Views.Pages.CollectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <!-- アイテム形式トグル用 RadioButton -->
        <Style x:Key="ItemFormatRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource AccentCyanBrush}"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentCyanColor}" Opacity="0.12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource BgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ─── 縦ツールバー ─── -->
        <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                <Button Style="{StaticResource VToolbarBtn}"
                        ToolTip="新規コレクション" Click="NewCollection_Click">
                    <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                </Button>
                <Button x:Name="BtnToolbarEdit" Style="{StaticResource VToolbarBtn}"
                        ToolTip="選択したコレクションを編集" Click="EditCollection_Click">
                    <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconLg}"/>
                </Button>
                <Button x:Name="BtnToolbarDelete" Style="{StaticResource VToolbarBtn}"
                        ToolTip="選択したコレクションを削除" Click="DeleteCollection_Click">
                    <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                </Button>
                <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>
                <Button x:Name="BtnToolbarSearch" Style="{StaticResource VToolbarBtn}"
                        ToolTip="検索バーを表示/非表示" Click="ToggleSearch_Click">
                    <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconLg}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ─── メインコンテンツ ─── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ヘッダー行: グリッド/リスト切り替え -->
            <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="8,4">
                <DockPanel>
                    <Border x:Name="BtnViewToggle" DockPanel.Dock="Right"
                            Width="36" Height="36" CornerRadius="6"
                            Cursor="Hand" VerticalAlignment="Center" Margin="0,0,4,0"
                            MouseLeftButtonUp="ToggleViewMode_Click">
                        <Path x:Name="ViewToggleIcon"
                              Data="{StaticResource Bi.ListUl}" Style="{StaticResource BiIcon}"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 検索バー（ヘッダー下・右寄せ） -->
            <Border x:Name="SearchSection" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Right" Margin="0,6,12,6"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconSm}"
                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Width="260"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource AccentCyanBrush}"
                             FontSize="13" VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- コンテンツエリア -->
            <Grid Grid.Row="2" Background="{StaticResource BgPrimaryBrush}">

                <!-- グリッド表示 -->
                <ScrollViewer x:Name="GridScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="CollectionGridControl" Margin="12,12,0,12"/>
                </ScrollViewer>

                <!-- リスト表示 -->
                <Grid x:Name="CollectionListSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- リストヘッダー -->
                    <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="16,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="コレクション名" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="アイテム形式" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="フィールド数" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="最終更新" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- リストアイテム -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CollectionListPanel"/>
                    </ScrollViewer>
                </Grid>

                <!-- 空状態 -->
                <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="56"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="コレクションがありません"
                               FontSize="15" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="ツールバーの「＋」から作成できます"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ─── 右ドロワー（プッシュ型） ─── -->
        <Border x:Name="DrawerContainer" Grid.Column="2" Width="0" ClipToBounds="True"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>

                <!-- 詳細パネル (480px) -->
                <DockPanel x:Name="DetailDrawer" Width="480" HorizontalAlignment="Left"
                           Visibility="Collapsed">
                    <!-- ヘッダー -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                    Click="CloseDetailPanel_Click" ToolTip="閉じる">
                                <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDetailIcon" FontSize="22" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtDetailName" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- フッター (編集/削除) -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="削除" Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Click="DeleteFromDetail_Click"/>
                            <Button Content="編集" Style="{StaticResource PrimaryButton}"
                                    Padding="18,6"
                                    Click="EditFromDetail_Click"/>
                        </StackPanel>
                    </Border>
                    <!-- コンテンツ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailContentPanel" Margin="24,16,24,16"/>
                    </ScrollViewer>
                </DockPanel>

                <!-- フォームパネル (500px) -->
                <DockPanel x:Name="FormDrawer" Width="500" HorizontalAlignment="Left"
                           Visibility="Collapsed">
                    <!-- フォームヘッダー -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                    Click="CancelForm_Click" ToolTip="閉じる">
                                <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                            </Button>
                            <TextBlock x:Name="TxtFormTitle" Text="新規コレクション"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <!-- フォームフッター -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="20,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Click="CancelForm_Click"/>
                            <Button x:Name="BtnFormSave" Content="作成"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="22,6" Click="SaveForm_Click"/>
                        </StackPanel>
                    </Border>
                    <!-- フォーム本体 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20,24,20">

                            <!-- 表紙画像 -->
                            <TextBlock Text="表紙画像（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Border x:Name="CoverImagePreviewBorder" Height="150" CornerRadius="6"
                                    Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,8" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="CoverImagePlaceholder"
                                               Text="画像を選択してください"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                                    <Image x:Name="CoverImagePreview" Stretch="UniformToFill"
                                           Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Style="{StaticResource SecondaryButton}" Padding="10,5"
                                        Click="BrowseCoverImage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                              Margin="0,0,4,0"/>
                                        <TextBlock Text="画像を選択" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClearCoverImage" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Margin="8,0,0,0"
                                        Click="ClearCoverImage_Click" Visibility="Collapsed">
                                    <TextBlock Text="クリア"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="基本情報" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="コレクション名 *" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtFormName"
                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="説明（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtFormDesc"
                                     Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="コレクションフォルダパス（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFormFolder" Grid.Column="0"
                                         Style="{StaticResource DarkTextBox}"/>
                                <Button Grid.Column="1" Content="参照..."
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Margin="6,0,0,0"
                                        Click="BrowseFolder_Click"/>
                            </Grid>

                            <TextBlock Text="アイテム形式" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <RadioButton x:Name="RbItemText"
                                             GroupName="ItemFormat" IsChecked="True"
                                             Style="{StaticResource ItemFormatRadio}"
                                             Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝" FontSize="14" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="文字列" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RbItemFile"
                                             GroupName="ItemFormat"
                                             Style="{StaticResource ItemFormatRadio}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" FontSize="14" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="ファイル指定" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}"
                                    Margin="0,0,0,18"/>

                            <TextBlock Text="データ付属情報" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="アイテムに付属させる情報フィールドを定義します"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,0,0,14"/>

                            <StackPanel x:Name="FormFieldListPanel" Margin="0,0,0,10"/>

                            <Border Background="{StaticResource BgSecondaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="フィールドを追加" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="付属情報名" FontSize="11"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtNewFieldName"
                                                     Style="{StaticResource DarkTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="データ形式" FontSize="11"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CbFieldType"
                                                      Style="{StaticResource DarkComboBox}"
                                                      SelectedIndex="0">
                                                <ComboBoxItem Tag="文字列">📝 文字列</ComboBoxItem>
                                                <ComboBoxItem Tag="画像">🖼 画像</ComboBoxItem>
                                                <ComboBoxItem Tag="リンク">🔗 リンク</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="＋ フィールドを追加"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,5" Margin="0,10,0,0"
                                            HorizontalAlignment="Right"
                                            Click="AddFormField_Click"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

            </Grid>
        </Border>

    </Grid>
</Page>

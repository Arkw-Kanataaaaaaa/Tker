<Page x:Class="TKer.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ページヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Bi.BarChartFill}" Style="{StaticResource BiIcon}"
                          Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="ダッシュボード"
                               FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Padding="10,5" FontSize="12" Margin="0,0,8,0"
                            Click="GoToDeliverable_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.ClipboardFill}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,5,0"/>
                            <TextBlock Text="成果物まとめ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- ⑥ 競合検知バナー -->
            <Border x:Name="ReloadBanner" Visibility="Collapsed" Margin="0,0,0,12"
                    Background="#1AFFD740"
                    BorderBrush="#66FFD740" BorderThickness="1"
                    CornerRadius="8" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                            Padding="8,4" Click="DismissReload_Click" ToolTip="閉じる">
                        <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Bi.ExclamationTriangleFill}" Style="{StaticResource BiIconSm}"
                              Fill="{StaticResource AccentYellowBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="プロジェクトファイルが外部で更新されました。最新データを読み込みました。"
                                   Foreground="{StaticResource AccentYellowBrush}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 統計カード -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border Margin="0,0,8,0" CornerRadius="10" Padding="16"
                        Background="{StaticResource BgCardBrush}"
                        BorderThickness="3,1,1,1"
                        BorderBrush="{StaticResource AccentBlueBrush}">
                    <StackPanel>
                        <TextBlock Text="総タスク数" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding TotalTasks}" FontFamily="Consolas"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,2"/>
                        <TextBlock Text="登録済みタスク" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Margin="4,0" CornerRadius="10" Padding="16"
                        Background="{StaticResource BgCardBrush}"
                        BorderThickness="3,1,1,1"
                        BorderBrush="{StaticResource AccentGreenBrush}">
                    <StackPanel>
                        <TextBlock Text="完了" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding DoneTasks}" FontFamily="Consolas"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGreenBrush}" Margin="0,4,0,2"/>
                        <TextBlock Text="タスク完了済み" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Margin="4,0" CornerRadius="10" Padding="16"
                        Background="{StaticResource BgCardBrush}"
                        BorderThickness="3,1,1,1"
                        BorderBrush="{StaticResource AccentOrangeBrush}">
                    <StackPanel>
                        <TextBlock Text="対応中" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding WipTasks}" FontFamily="Consolas"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource AccentOrangeBrush}" Margin="0,4,0,2"/>
                        <TextBlock Text="作業進行中" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Margin="8,0,0,0" CornerRadius="10" Padding="16"
                        Background="{StaticResource BgCardBrush}"
                        BorderThickness="3,1,1,1"
                        BorderBrush="{StaticResource TextDimBrush}">
                    <StackPanel>
                        <TextBlock Text="未着手" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding TodoTasks}" FontFamily="Consolas"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                        <TextBlock Text="着手待ちタスク" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 実績サマリー（最上位） -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Bi.BarChartFill}" Style="{StaticResource BiIconSm}"
                                  Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="実績サマリー" FontFamily="Yu Gothic UI" FontWeight="Bold"
                                       FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ActualSummaryLabel" DockPanel.Dock="Right"
                                   FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- 合計時間カード -->
                    <UniformGrid x:Name="ActualStatsGrid" Columns="3" Margin="0,0,0,12"/>
                    <!-- タスク別実績リスト -->
                    <ListView x:Name="ActualTaskList"
                              Background="Transparent" BorderThickness="0"
                              MaxHeight="200"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background"     Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding"         Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TaskName}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CategoryName}"
                                                   FontSize="11" Margin="8,0"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalHours, StringFormat='{}{0:F1}h'}"
                                                   FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentGreenBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- 最近のタスク -->
                <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="最近のタスク" FontFamily="Yu Gothic UI" FontWeight="Bold"
                                   FontSize="15" Margin="0,0,0,12"/>
                        <ListView x:Name="RecentTaskList"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background"     Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                <TextBlock Text="{Binding Assignee}" FontSize="11"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Priority}"
                                                       FontSize="11" Margin="8,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                       FontSize="12" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- プロジェクト情報 -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="プロジェクト情報" FontFamily="Yu Gothic UI" FontWeight="Bold"
                                   FontSize="15" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名前" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProjectService.CurrentProject.Settings.ProjectName}"
                                       FontSize="13" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="作成日" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProjectService.CurrentProject.Settings.CreatedAt,
                                              StringFormat='yyyy/MM/dd'}"
                                       FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="カテゴリ" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CategoryCount, StringFormat='{}{0} 件'}"
                                       FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="保存日時" Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProjectService.CurrentProject.LastSaved,
                                              StringFormat='yyyy/MM/dd HH:mm'}"
                                       FontSize="11" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>

                        <!-- 進捗バー -->
                        <TextBlock Text="完了率" Foreground="{StaticResource TextDimBrush}"
                                   FontSize="11" Margin="0,0,0,6"/>
                        <Grid x:Name="ProgressBarBg">
                            <Border Height="8" CornerRadius="4"
                                    Background="{StaticResource BorderBrush}"/>
                            <Border x:Name="ProgressBarFill" Height="8" CornerRadius="4"
                                    Background="{StaticResource AccentGreenBrush}"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="ProgressText" Text="0%"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>

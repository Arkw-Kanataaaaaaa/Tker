<Page x:Class="TKer.Views.Pages.GanttPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Padding="24,14" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="ガントチャート" FontFamily="Yu Gothic UI" FontWeight="Bold"
                           FontSize="20" Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                            Padding="8,5" Click="PrevMonth_Click" ToolTip="前の月">
                        <Path Data="{StaticResource Bi.ChevronLeft}" Style="{StaticResource BiIconSm}"/>
                    </Button>
                    <TextBlock x:Name="MonthLabel" FontFamily="Consolas" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" MinWidth="110" TextAlignment="Center"/>
                    <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                            Padding="8,5" Click="NextMonth_Click" ToolTip="次の月">
                        <Path Data="{StaticResource Bi.ChevronRight}" Style="{StaticResource BiIconSm}"/>
                    </Button>
                    <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="4,0"/>
                    <Button Margin="0,0,8,0" Content="今日" Style="{StaticResource SecondaryButton}"
                            Padding="10,5" Click="Today_Click"/>
                    <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                            Padding="10,5" Click="FitAll_Click" ToolTip="全体表示">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.ArrowsFullscreen}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,4,0"/>
                            <TextBlock Text="全体表示" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToggleCompletedBtn" Margin="0,0,8,0" Content="完了を非表示"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,5" Click="ToggleCompleted_Click"/>
                    <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                            Padding="8,5" Click="Refresh_Click" ToolTip="更新">
                        <Path Data="{StaticResource Bi.ArrowClockwise}" Style="{StaticResource BiIconSm}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 凡例 -->
        <Border Grid.Row="1" Padding="24,8" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="10" CornerRadius="2" Background="#613D7EFF"/>
                    <TextBlock Text="予定" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="24" Height="10" CornerRadius="2" Background="#6100E676"/>
                    <TextBlock Text="実績" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="2" Height="14" Background="{StaticResource AccentCyanBrush}"/>
                    <TextBlock Text="今日" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ガント本体 -->
        <Border Grid.Row="2" Margin="24,16" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左上：固定ヘッダーラベル -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,1" Padding="14,0">
                    <TextBlock Text="タスク" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="Bold" VerticalAlignment="Center"/>
                </Border>

                <!-- 右上：日付ヘッダー（横スクロール連動） -->
                <ScrollViewer Grid.Row="0" Grid.Column="1" x:Name="HeaderScroll"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Background="{StaticResource BgSecondaryBrush}">
                    <Canvas x:Name="DateHeaderCanvas" Height="40"/>
                </ScrollViewer>

                <!-- 左下：ラベル列（縦スクロール連動） ③ -->
                <ScrollViewer Grid.Row="1" Grid.Column="0" x:Name="LabelScroll"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,0,1,0"
                              ScrollChanged="LabelScroll_ScrollChanged">
                    <StackPanel x:Name="LabelColumn"/>
                </ScrollViewer>

                <!-- 右下：バー Canvas（縦横スクロール） -->
                <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="BodyVScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="BodyVScroll_ScrollChanged">
                    <ScrollViewer x:Name="BarScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Hidden"
                                  ScrollChanged="BarScroll_ScrollChanged">
                        <Canvas x:Name="GanttCanvas"/>
                    </ScrollViewer>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Page>

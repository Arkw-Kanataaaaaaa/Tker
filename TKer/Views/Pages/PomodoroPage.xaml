<Page x:Class="TKer.Views.Pages.PomodoroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ページヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,12"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="ポモドーロタイマー"
                       FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- 左：タイマーメイン -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="480">

                    <!-- モードバッジ -->
                    <Border x:Name="ModeBadge" HorizontalAlignment="Center" CornerRadius="20"
                            Padding="24,6" Margin="0,0,0,24">
                        <Border.Background>
                            <SolidColorBrush x:Name="ModeBadgeBrush" Color="#FF2383E2"/>
                        </Border.Background>
                        <TextBlock x:Name="TxtMode" Text="作業中" FontSize="14" FontWeight="Bold"
                                   Foreground="White" FontFamily="Yu Gothic UI"/>
                    </Border>

                    <!-- タイマー円 -->
                    <Grid HorizontalAlignment="Center" Width="280" Height="280" Margin="0,0,0,32">
                        <!-- 背景リング -->
                        <Ellipse StrokeThickness="12" Stroke="{StaticResource BorderBrush}"
                                 Width="280" Height="280"/>
                        <!-- 進捗リング（コードビハインドで描画） -->
                        <Canvas x:Name="ProgressCanvas" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- 時間表示 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtTime" Text="25:00"
                                       FontSize="56" FontWeight="Bold" FontFamily="Consolas"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtSession" Text="セッション 1 / 4"
                                       FontSize="13" Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- コントロールボタン -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Button x:Name="BtnReset" Content="リセット" Style="{StaticResource SecondaryButton}"
                                Padding="18,10" Margin="0,0,12,0" Click="BtnReset_Click"/>
                        <Button x:Name="BtnStartStop" Content="▶ 開始" Style="{StaticResource PrimaryButton}"
                                Padding="28,10" FontSize="15" Click="BtnStartStop_Click"/>
                        <Button x:Name="BtnSkip" Content="スキップ" Style="{StaticResource SecondaryButton}"
                                Padding="18,10" Margin="12,0,0,0" Click="BtnSkip_Click"/>
                    </StackPanel>

                    <!-- 完了済みセッション -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="完了済み" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel x:Name="SessionDots" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 今日の統計 -->
                    <Border Margin="0,32,0,0" Padding="20,16" CornerRadius="10"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="今日の記録" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <UniformGrid Columns="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtTodaySessions" Text="0"
                                               FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="セッション" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtTodayMinutes" Text="0"
                                               FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="分" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtTodayBreaks" Text="0"
                                               FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                               Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="休憩" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右：設定パネル -->
                <Border Grid.Column="1" Margin="24,0,0,0" Padding="20"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="タイマー設定" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- 作業時間 -->
                        <TextBlock Text="作業時間（分）" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="−" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Padding="0"
                                    Click="BtnWorkMinus_Click"/>
                            <TextBox x:Name="TxtWorkMin" Text="25" Width="60" Margin="8,0"
                                     Style="{StaticResource DarkTextBox}" TextAlignment="Center" FontSize="16"/>
                            <Button Content="＋" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Padding="0"
                                    Click="BtnWorkPlus_Click"/>
                        </StackPanel>

                        <!-- 短い休憩 -->
                        <TextBlock Text="短い休憩（分）" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="−" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Padding="0"
                                    Click="BtnShortMinus_Click"/>
                            <TextBox x:Name="TxtShortMin" Text="5" Width="60" Margin="8,0"
                                     Style="{StaticResource DarkTextBox}" TextAlignment="Center" FontSize="16"/>
                            <Button Content="＋" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Padding="0"
                                    Click="BtnShortPlus_Click"/>
                        </StackPanel>

                        <!-- 長い休憩 -->
                        <TextBlock Text="長い休憩（分）" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="−" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Padding="0"
                                    Click="BtnLongMinus_Click"/>
                            <TextBox x:Name="TxtLongMin" Text="15" Width="60" Margin="8,0"
                                     Style="{StaticResource DarkTextBox}" TextAlignment="Center" FontSize="16"/>
                            <Button Content="＋" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Padding="0"
                                    Click="BtnLongPlus_Click"/>
                        </StackPanel>

                        <!-- セッション数 -->
                        <TextBlock Text="長い休憩まで（セッション数）" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="−" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Padding="0"
                                    Click="BtnSessionsMinus_Click"/>
                            <TextBox x:Name="TxtSessions" Text="4" Width="60" Margin="8,0"
                                     Style="{StaticResource DarkTextBox}" TextAlignment="Center" FontSize="16"/>
                            <Button Content="＋" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Padding="0"
                                    Click="BtnSessionsPlus_Click"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,16" Background="{StaticResource BorderBrush}"/>

                        <!-- オプション -->
                        <CheckBox x:Name="ChkStopMedia" Content="休憩時にメディアを停止"
                                  Style="{StaticResource DarkCheckBox}"
                                  Margin="0,0,0,8" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
                        <CheckBox x:Name="ChkNotify" Content="完了時に通知"
                                  Style="{StaticResource DarkCheckBox}"
                                  Margin="0,0,0,16" Checked="Settings_Changed" Unchecked="Settings_Changed"/>

                        <Button Content="設定を適用" Style="{StaticResource PrimaryButton}"
                                Padding="12,8" HorizontalAlignment="Stretch"
                                Click="BtnApplySettings_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

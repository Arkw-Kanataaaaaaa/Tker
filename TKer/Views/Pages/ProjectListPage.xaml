<Page x:Class="TKer.Views.Pages.ProjectListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ページヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,12" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- グリッド/リスト切替ボタン -->
                <Border x:Name="BtnViewToggle" DockPanel.Dock="Right"
                        Width="30" Height="30" CornerRadius="6" Cursor="Hand"
                        MouseLeftButtonUp="ToggleView_Click" ToolTip="リスト表示に切り替え"
                        Margin="0,0,4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Background="Transparent">
                        <Path x:Name="ViewIconGrid" Data="{StaticResource Bi.Grid3x3Gap}" Style="{StaticResource BiIconLg}"/>
                        <Path x:Name="ViewIconList" Data="{StaticResource Bi.ListUl}" Style="{StaticResource BiIconLg}"
                              Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <!-- ソートボタン + ラベル -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border x:Name="BtnSortToggle"
                            Width="30" Height="30" CornerRadius="6" Cursor="Hand"
                            MouseLeftButtonUp="SortButton_Click" ToolTip="ソート順を変更">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Background="Transparent">
                            <Path Data="{StaticResource Bi.ArrowDownUp}" Style="{StaticResource BiIconLg}"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SortModeLabel" Text="更新日時 ↓" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="プロジェクト"
                               FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 検索バー行は Col=1 内に移動（ここは空にしてスペース不使用） -->

        <!-- メインコンテンツ: 縦型ツールバー + プロジェクトコンテンツ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 縦型ツールバー (Col 0) -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">

                    <!-- プロジェクト操作ボタン群（Project Detail mode） -->
                    <StackPanel x:Name="BtnProjectSection">
                        <Button x:Name="BtnEditSettings" ToolTip="プロジェクト編集 (F2)" Style="{StaticResource VToolbarBtn}"
                                Click="EditSettings_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button ToolTip="プロジェクト追加 (Ctrl+Shift+;)" Style="{StaticResource VToolbarBtn}"
                                Click="NewProject_Click">
                            <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnRemoveSelected" ToolTip="プロジェクト削除 (Ctrl+-)" Style="{StaticResource VToolbarBtn}"
                                Click="RemoveSelected_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button ToolTip="プロジェクト読み込み (Ctrl+N)" Style="{StaticResource VToolbarBtn}"
                                Click="LoadProject_Click">
                            <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnSetActive" ToolTip="アクティブに設定 (Ctrl+A)" Style="{StaticResource VToolbarBtn}"
                                Click="SetActive_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.CheckCircleFill}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnOpenFolder" ToolTip="フォルダを開く (Ctrl+O)" Style="{StaticResource VToolbarBtn}"
                                Click="OpenFolder_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button ToolTip="フォルダ整理" Style="{StaticResource VToolbarBtn}"
                                Click="Organize_Click">
                            <Path Data="{StaticResource Bi.WrenchFill}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>
                        <Button ToolTip="検索 (Ctrl+F)" Style="{StaticResource VToolbarBtn}"
                                Click="ToggleSearch_Click">
                            <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button ToolTip="カテゴリテンプレート" Style="{StaticResource VToolbarBtn}"
                                Click="CategoryTemplate_Click">
                            <Path Data="{StaticResource Bi.LayoutTextWindow}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- プロジェクトコンテンツ (Col 1) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 検索バー（ヘッダー下・右寄せ、Col=1 内のみ） -->
                <Border x:Name="SearchSection" Grid.Row="0" Visibility="Collapsed"
                        HorizontalAlignment="Right" Margin="0,6,12,6"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconSm}"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Width="260"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentCyanBrush}"
                                 Tag="プロジェクト名・説明で検索"
                                 FontSize="13" VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ContentBorder" Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8,8,8">
                    <StackPanel>
                        <Border x:Name="NoProjectBanner" Visibility="Collapsed"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="24,20" Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconXl}"
                                      HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="プロジェクトがありません"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="左のツールバーから新規作成または既存を開いてください"
                                           FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- グリッド表示 -->
                        <ItemsControl x:Name="ProjectGridControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" Margin="4,4,4,4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="170" Height="220" CornerRadius="12" Margin="6"
                                            ClipToBounds="True" Cursor="Hand"
                                            MouseLeftButtonUp="ProjectCard_Click">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,170,220" RadiusX="12" RadiusY="12"/>
                                        </Border.Clip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- 背景（カバー画像なし時） -->
                                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"/>
                                            <!-- カバー画像 -->
                                            <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"/>
                                            <!-- カバー画像なし時のプレースホルダーアイコン -->
                                            <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconXl}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasNoCover, Converter={StaticResource BoolVis}}"/>
                                            <!-- 選択枠 -->
                                            <Border CornerRadius="12" BorderThickness="3" Background="Transparent"
                                                    BorderBrush="{StaticResource AccentCyanBrush}"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>
                                            <!-- アクティブ星マーク -->
                                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Padding="8,8,0,0">
                                                <Path Data="{StaticResource Bi.StarFill}" Style="{StaticResource BiIconSm}"
                                                      Fill="{StaticResource AccentYellowBrush}"
                                                      Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                            </Border>
                                            <!-- プロジェクト名オーバーレイ（下部） -->
                                            <Border VerticalAlignment="Bottom" Background="#AA000000"
                                                    Padding="10,6,10,10">
                                                <TextBlock Text="{Binding Entry.ProjectName}"
                                                           Foreground="#E8FFFFFF" FontWeight="Bold" FontSize="13"
                                                           FontFamily="Yu Gothic UI" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <!-- ホバー時の進捗オーバーレイ（中央） -->
                                            <Border Background="#AA000000" CornerRadius="12" Padding="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <Binding Path="IsMouseOver"
                                                                             RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Border}, AncestorLevel=1}"/>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding ProgressLabel}"
                                                               FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HoverDetail}"
                                                               FontSize="11" Foreground="#CCFFFFFF"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- リスト表示 -->
                        <StackPanel x:Name="ProjectListSection" Visibility="Collapsed">
                            <!-- ヘッダー行 -->
                            <Border Padding="16,8,16,8"
                                    Background="{StaticResource BgSecondaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="プロジェクト名" Grid.Column="0"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="プロジェクト期間" Grid.Column="1"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="進捗率" Grid.Column="2"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="作成日時" Grid.Column="3"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="更新日時" Grid.Column="4"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <!-- リスト行 -->
                            <ItemsControl x:Name="ProjectListItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,10,16,10" Cursor="Hand"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                MouseLeftButtonUp="ProjectCard_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 名前列 -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Bi.StarFill}" Style="{StaticResource BiIconSm}"
                                                          Fill="{StaticResource AccentYellowBrush}" Margin="0,0,6,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                                    <TextBlock Text="{Binding Entry.ProjectName}"
                                                               FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- プロジェクト期間列 -->
                                                <TextBlock Grid.Column="1" Text="{Binding PeriodLabel}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- 進捗率列 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="50" Height="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Border CornerRadius="2" Background="{StaticResource BorderBrush}"/>
                                                        <Border CornerRadius="2" Background="{StaticResource AccentGreenBrush}"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding ProgressRate,
                                                                    Converter={StaticResource PercentToWidthConverter},
                                                                    ConverterParameter=50}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ProgressLabel}"
                                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentGreenBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- 作成日時列 -->
                                                <TextBlock Grid.Column="3" Text="{Binding CreatedAtLabel}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <!-- 更新日時列 -->
                                                <TextBlock Grid.Column="4" Text="{Binding UpdatedAtLabel}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

            <!-- ─── 右ドロワー（プッシュ型） ─── -->
            <Border x:Name="DrawerContainer" Grid.Column="2" Width="0" ClipToBounds="True"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>

                    <!-- プロジェクト詳細パネル -->
                    <ScrollViewer x:Name="DetailDrawerScroll" Width="500" HorizontalAlignment="Left"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">
                            <!-- ヘッダー行 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="24,0,24,12" Margin="-24,0,-24,16">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                            ToolTip="閉じる" Click="CloseDetailPanel_Click">
                                        <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                                    </Button>
                                    <TextBlock x:Name="DetailPanelTitle"
                                               FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <StackPanel x:Name="ProjectInfoContent"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 新規作成パネル -->
                    <DockPanel x:Name="AddDrawerScroll" Width="500" HorizontalAlignment="Left"
                               Visibility="Collapsed">
                        <!-- フッター（固定） -->
                        <Border DockPanel.Dock="Bottom"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="20,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                                        Padding="14,6" Margin="0,0,8,0"
                                        Click="CancelAddProject_Click"/>
                                <Button Content="作成" Style="{StaticResource PrimaryButton}"
                                        Padding="22,6"
                                        Click="CreateProject_Click"/>
                            </StackPanel>
                        </Border>
                        <!-- スクロール可能コンテンツ -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">

                            <!-- ヘッダー行 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="24,0,24,12" Margin="-24,0,-24,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                            ToolTip="閉じる" Click="CancelAddProject_Click">
                                        <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                                    </Button>
                                    <TextBlock Text="新規プロジェクト"
                                               FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- プロジェクト名 -->
                            <TextBlock Text="プロジェクト名 *" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewProjName" Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,16"/>

                            <!-- 表紙画像 -->
                            <TextBlock Text="表紙画像（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Border x:Name="CoverImagePreviewBorder" Height="160" CornerRadius="6"
                                    Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,8" ClipToBounds="True"
                                    AllowDrop="True"
                                    DragEnter="CoverImage_DragEnter" DragOver="CoverImage_DragOver"
                                    DragLeave="CoverImage_DragLeave" Drop="CoverImage_Drop">
                                <Grid>
                                    <TextBlock x:Name="CoverImagePlaceholder"
                                               Text="ドラッグ＆ドロップ、または下のボタンで画像を選択"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                                    <Image x:Name="CoverImagePreview" Stretch="UniformToFill"
                                           Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Style="{StaticResource SecondaryButton}" Padding="10,5"
                                        Click="BrowseCoverImage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                              Margin="0,0,4,0"/>
                                        <TextBlock Text="画像を選択" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClearCoverImage" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Margin="8,0,0,0"
                                        Click="ClearCoverImage_Click" Visibility="Collapsed">
                                    <TextBlock Text="クリア"/>
                                </Button>
                            </StackPanel>

                            <!-- 説明 -->
                            <TextBlock Text="説明（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewProjDesc" Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,16"/>

                            <!-- フォルダ管理オプション -->
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Border x:Name="FolderMgmtToggleSwitch" DockPanel.Dock="Right"
                                                Width="44" Height="24" CornerRadius="12"
                                                Cursor="Hand" MouseLeftButtonUp="ToggleFolderManagement_Click">
                                            <Grid>
                                                <Border x:Name="FolderMgmtThumb" Width="20" Height="20" CornerRadius="10"
                                                        Background="White" HorizontalAlignment="Left"
                                                        Margin="22,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="フォルダ管理" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDimBrush}">
                                        オンにすると、カテゴリー・タスクに対応したフォルダ構造をプロジェクトフォルダ内に作成・管理します。&#x0a;オフにすると、フォルダ表示機能が無効になります。
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 保存先フォルダ（フォルダ管理ONの場合のみ表示） -->
                            <StackPanel x:Name="FolderPathSection" Margin="0,0,0,12">
                                <TextBlock Text="保存先フォルダ *" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtNewProjPath" Style="{StaticResource DarkTextBox}"
                                             IsReadOnly="True" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" Click="BrowseNewProjPath_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                                  Margin="0,0,4,0"/>
                                            <TextBlock Text="参照" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- プロジェクト期間 -->
                            <TextBlock Text="プロジェクト期間（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewProjStartDate" Style="{StaticResource DarkTextBox}"
                                         Tag="yyyy/MM/dd"/>
                                <TextBlock Grid.Column="1" Text="〜" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtNewProjEndDate" Grid.Column="2"
                                         Style="{StaticResource DarkTextBox}" Tag="yyyy/MM/dd"/>
                            </Grid>

                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- 編集パネル -->
                    <ScrollViewer x:Name="EditDrawerScroll" Width="500" HorizontalAlignment="Left"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,20,24,24">

                            <!-- ヘッダー行 -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="24,0,24,12" Margin="-24,0,-24,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                            ToolTip="閉じる" Click="CancelEditProject_Click">
                                        <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                                    </Button>
                                    <TextBlock Text="プロジェクトを編集"
                                               FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- プロジェクト名 -->
                            <TextBlock Text="プロジェクト名 *" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEditProjName" Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,16"/>

                            <!-- 表紙画像 -->
                            <TextBlock Text="表紙画像（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Border x:Name="EditCoverImagePreviewBorder" Height="160" CornerRadius="6"
                                    Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,8" ClipToBounds="True"
                                    AllowDrop="True"
                                    DragEnter="CoverImage_DragEnter" DragOver="CoverImage_DragOver"
                                    DragLeave="CoverImage_DragLeave" Drop="EditCoverImage_Drop">
                                <Grid>
                                    <TextBlock x:Name="EditCoverImagePlaceholder"
                                               Text="ドラッグ＆ドロップ、または下のボタンで画像を選択"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                                    <Image x:Name="EditCoverImagePreview" Stretch="UniformToFill"
                                           Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Style="{StaticResource SecondaryButton}" Padding="10,5"
                                        Click="BrowseEditCoverImage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                              Margin="0,0,4,0"/>
                                        <TextBlock Text="画像を選択" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClearEditCoverImage" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Margin="8,0,0,0"
                                        Click="ClearEditCoverImage_Click" Visibility="Collapsed">
                                    <TextBlock Text="クリア"/>
                                </Button>
                            </StackPanel>

                            <!-- 説明 -->
                            <TextBlock Text="説明（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEditProjDesc" Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,16"/>

                            <!-- フォルダ管理オプション -->
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Border x:Name="EditFolderMgmtToggleSwitch" DockPanel.Dock="Right"
                                                Width="44" Height="24" CornerRadius="12"
                                                Cursor="Hand" MouseLeftButtonUp="ToggleEditFolderManagement_Click">
                                            <Grid>
                                                <Border x:Name="EditFolderMgmtThumb" Width="20" Height="20" CornerRadius="10"
                                                        Background="White" HorizontalAlignment="Left"
                                                        Margin="22,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="フォルダ管理" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDimBrush}">
                                        オンにすると、カテゴリー・タスクに対応したフォルダ構造をプロジェクトフォルダ内に作成・管理します。&#x0a;オフにすると、フォルダ表示機能が無効になります。
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 保存先フォルダ（フォルダ管理ONの場合のみ表示） -->
                            <StackPanel x:Name="EditFolderPathSection" Margin="0,0,0,12">
                                <TextBlock Text="保存先フォルダ" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtEditProjPath" Style="{StaticResource DarkTextBox}"
                                             IsReadOnly="True" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" Click="BrowseEditProjPath_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                                  Margin="0,0,4,0"/>
                                            <TextBlock Text="参照" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- プロジェクト期間 -->
                            <TextBlock Text="プロジェクト期間（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtEditProjStartDate" Style="{StaticResource DarkTextBox}"
                                         Tag="yyyy/MM/dd"/>
                                <TextBlock Grid.Column="1" Text="〜" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtEditProjEndDate" Grid.Column="2"
                                         Style="{StaticResource DarkTextBox}" Tag="yyyy/MM/dd"/>
                            </Grid>

                            <!-- ボタン群 -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                        Padding="24,8" Margin="0,0,8,0" Click="SaveEditProject_Click"/>
                                <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                                        Padding="14,8" Click="CancelEditProject_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>

        <!-- 削除進捗エリア -->
        <Border x:Name="DeletionArea" Grid.Row="3" Visibility="Collapsed"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtDeletionProject" Grid.Column="0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,16,0" MaxWidth="260"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="DeletionProgressBar" Grid.Column="1"
                             Height="6" Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource AccentCyanBrush}"/>
                <TextBlock x:Name="TxtDeletionPct" Grid.Column="2"
                           Foreground="{StaticResource AccentCyanBrush}"
                           FontFamily="Consolas" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="8,0,0,0" Text="0%"/>
            </Grid>
        </Border>

        <!-- ─── 画像プレビュー オーバーレイ ─── -->
        <Grid x:Name="PreviewOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1000"
              Visibility="Collapsed" Background="#DC000000"
              MouseWheel="PreviewOverlay_MouseWheel"
              MouseLeftButtonDown="PreviewOverlay_MouseDown"
              MouseMove="PreviewOverlay_MouseMove"
              MouseLeftButtonUp="PreviewOverlay_MouseUp">
            <Image x:Name="PreviewImage" Stretch="Uniform"
                   MaxWidth="1200" MaxHeight="800"
                   RenderTransformOrigin="0.5,0.5"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <TextBlock Text="×" FontSize="26" FontWeight="Bold" Foreground="White" Cursor="Hand"
                       Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,8,16,0" MouseLeftButtonUp="ClosePreview_Click"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="16,0,0,16">
                <Border x:Name="ZoomTrack" Width="160" Height="16" Background="Transparent" Cursor="Hand"
                        VerticalAlignment="Center"
                        MouseLeftButtonDown="ZoomTrack_MouseDown"
                        MouseMove="ZoomTrack_MouseMove"
                        MouseLeftButtonUp="ZoomTrack_MouseUp">
                    <Grid>
                        <Border Height="6" CornerRadius="3" Background="#55FFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="PreviewZoomFill" Height="6" Width="0" CornerRadius="3"
                                Background="{StaticResource AccentCyanBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Ellipse x:Name="ZoomThumb" Width="14" Height="14" Fill="White"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="0,0,0,0"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="PreviewZoomLabel" Text="0%" FontSize="11" Foreground="White"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ソート選択ポップアップ -->
        <Popup x:Name="SortPopup" StaysOpen="False" Placement="Bottom"
               PlacementTarget="{Binding ElementName=BtnSortToggle}">
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="4" MinWidth="150">
                <StackPanel>
                    <Border x:Name="SortOptName" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="SortByName_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortOptNameText" Text="プロジェクト名" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border x:Name="SortOptProgress" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="SortByProgress_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortOptProgressText" Text="進捗率" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border x:Name="SortOptCreated" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="SortByCreated_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortOptCreatedText" Text="作成日時" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border x:Name="SortOptUpdated" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="SortByUpdated_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortOptUpdatedText" Text="更新日時" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="4,4,4,4"/>
                    <Border x:Name="SortDirectionRow" Padding="12,8" CornerRadius="4" Cursor="Hand"
                            MouseLeftButtonUp="ToggleSortDirection_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="SortDirectionText" Text="降順 ↓" FontSize="13"
                                   Foreground="{DynamicResource AccentCyanBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>

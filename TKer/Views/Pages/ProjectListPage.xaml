<Page x:Class="TKer.Views.Pages.ProjectListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.Resources>
            <!-- ツリーアイテム用コンテキストメニュー -->
            <ContextMenu x:Key="TreeItemContextMenu" Opened="TreeContextMenu_Opened">
                <MenuItem Tag="CtxOpen"      Header="📂 開く"          Click="FileOp_Open_Click"/>
                <Separator/>
                <MenuItem Tag="CtxNewFolder" Header="📁 新規フォルダ"  Click="FileOp_NewFolder_Click"/>
                <MenuItem Tag="CtxNewFile"   Header="📄 新規ファイル"  Click="FileOp_NewFile_Click"/>
                <Separator/>
                <MenuItem Tag="CtxRename"    Header="✏ 名前変更"       Click="FileOp_Rename_Click"/>
                <MenuItem Tag="CtxCopyPath"  Header="🔗 パスをコピー"  Click="FileOp_CopyPath_Click"/>
                <Separator/>
                <MenuItem Tag="CtxDelete"    Header="🗑 削除"           Click="FileOp_Delete_Click"
                          Foreground="#FFCC44"/>
            </ContextMenu>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ページヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,12" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- グリッド/リスト切替ボタン -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Border x:Name="BtnViewGrid" Width="30" Height="30" CornerRadius="6" Cursor="Hand"
                            MouseLeftButtonUp="SetGridView_Click" ToolTip="グリッド表示" Margin="0,0,4,0">
                        <Path Data="{StaticResource Bi.Grid3x3Gap}" Style="{StaticResource BiIconSm}"/>
                    </Border>
                    <Border x:Name="BtnViewList" Width="30" Height="30" CornerRadius="6" Cursor="Hand"
                            MouseLeftButtonUp="SetListView_Click" ToolTip="リスト表示">
                        <Path Data="{StaticResource Bi.ListUl}" Style="{StaticResource BiIconSm}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="プロジェクト"
                               FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 検索セクション（アニメーション付き） -->
        <Border x:Name="SearchSection" Grid.Row="1" Visibility="Collapsed"
                ClipToBounds="True"
                Padding="12,8" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="280"
                         Style="{StaticResource DarkTextBox}"
                         Tag="プロジェクト名・説明で検索"
                         TextChanged="SearchBox_TextChanged"
                         VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- メインコンテンツ: 縦型ツールバー + プロジェクトコンテンツ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 縦型ツールバー (Col 0) -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">

                    <!-- プロジェクト操作ボタン群（Project Detail mode） -->
                    <StackPanel x:Name="BtnProjectSection">
                        <Button ToolTip="プロジェクト読み込み (Ctrl+N)" Style="{StaticResource VToolbarBtn}"
                                Click="LoadProject_Click">
                            <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnSetActive" ToolTip="アクティブに設定 (Ctrl+A)" Style="{StaticResource VToolbarBtn}"
                                Click="SetActive_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.CheckCircleFill}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnOpenFolder" ToolTip="フォルダを開く (Ctrl+O)" Style="{StaticResource VToolbarBtn}"
                                Click="OpenFolder_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnEditSettings" ToolTip="プロジェクト編集 (F2)" Style="{StaticResource VToolbarBtn}"
                                Click="EditSettings_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button ToolTip="プロジェクト追加 (Ctrl+Shift+;)" Style="{StaticResource VToolbarBtn}"
                                Click="NewProject_Click">
                            <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnRemoveSelected" ToolTip="プロジェクト削除 (Ctrl+-)" Style="{StaticResource VToolbarBtn}"
                                Click="RemoveSelected_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button ToolTip="検索 (Ctrl+F)" Style="{StaticResource VToolbarBtn}"
                                Click="ToggleSearch_Click">
                            <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                    </StackPanel>

                    <!-- ファイル操作ボタン群（Folder mode） -->
                    <StackPanel x:Name="BtnTreeSection" Visibility="Collapsed">
                        <Button x:Name="BtnOpen" ToolTip="開く" Style="{StaticResource VToolbarBtn}"
                                Click="FileOp_Open_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.BoxArrowUp}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnNewFolder" ToolTip="新規フォルダ" Style="{StaticResource VToolbarBtn}"
                                Click="FileOp_NewFolder_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnNewFile" ToolTip="新規ファイル" Style="{StaticResource VToolbarBtn}"
                                Click="FileOp_NewFile_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.FileEarmarkText}" Style="{StaticResource BiIconLg}"/>
                        </Button>

                        <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>

                        <Button x:Name="BtnRename" ToolTip="名前変更 (F2)" Style="{StaticResource VToolbarBtn}"
                                Click="FileOp_Rename_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnCopyPath" ToolTip="パスをコピー" Style="{StaticResource VToolbarBtn}"
                                Click="FileOp_CopyPath_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.Link45deg}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button x:Name="BtnDelete" ToolTip="削除" Style="{StaticResource VToolbarBtn}"
                                Click="FileOp_Delete_Click" IsEnabled="False">
                            <Path Data="{StaticResource Bi.Trash3}" Style="{StaticResource BiIconLg}"
                                  Fill="#FFCC44"/>
                        </Button>

                        <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>

                        <Button ToolTip="更新" Style="{StaticResource VToolbarBtn}"
                                Click="RefreshTree_Click">
                            <Path Data="{StaticResource Bi.ArrowClockwise}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button ToolTip="フォルダ整理" Style="{StaticResource VToolbarBtn}"
                                Click="Organize_Click">
                            <Path Data="{StaticResource Bi.WrenchFill}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                        <Button ToolTip="エクスプローラーで開く" Style="{StaticResource VToolbarBtn}"
                                Click="OpenExplorer_Click">
                            <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconLg}"/>
                        </Button>

                        <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>

                        <Button x:Name="BtnColumnConfig" ToolTip="列設定（詳細パネルの列表示を設定）"
                                Style="{StaticResource VToolbarBtn}" Click="BtnColumnConfig_Click">
                            <Path Data="{StaticResource Bi.GearFill}" Style="{StaticResource BiIconLg}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- プロジェクトコンテンツ (Col 1) -->
            <Border x:Name="ContentBorder" Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,8,8">
                    <StackPanel>
                        <Border x:Name="NoProjectBanner" Visibility="Collapsed"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="24,20" Margin="0,0,0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconXl}"
                                      HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="プロジェクトがありません"
                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="左のツールバーから新規作成または既存を開いてください"
                                           FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- グリッド表示 -->
                        <ItemsControl x:Name="ProjectGridControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" Margin="4,4,4,4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="170" Height="220" CornerRadius="12" Margin="6"
                                            ClipToBounds="True" Cursor="Hand"
                                            MouseLeftButtonUp="ProjectCard_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- 背景（カバー画像なし時） -->
                                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"/>
                                            <!-- カバー画像 -->
                                            <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"/>
                                            <!-- カバー画像なし時のプレースホルダーアイコン -->
                                            <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconXl}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasNoCover, Converter={StaticResource BoolVis}}"/>
                                            <!-- 選択枠 -->
                                            <Border CornerRadius="12" BorderThickness="3" Background="Transparent"
                                                    BorderBrush="{StaticResource AccentCyanBrush}"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}"/>
                                            <!-- アクティブ星マーク -->
                                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Padding="8,8,0,0">
                                                <Path Data="{StaticResource Bi.StarFill}" Style="{StaticResource BiIconSm}"
                                                      Fill="{StaticResource AccentYellowBrush}"
                                                      Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                            </Border>
                                            <!-- プロジェクト名オーバーレイ（下部） -->
                                            <Border VerticalAlignment="Bottom" Background="#AA000000"
                                                    Padding="10,6,10,10">
                                                <TextBlock Text="{Binding Entry.ProjectName}"
                                                           Foreground="#E8FFFFFF" FontWeight="Bold" FontSize="13"
                                                           FontFamily="Yu Gothic UI" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <!-- ホバー時の進捗オーバーレイ（中央） -->
                                            <Border Background="#AA000000" CornerRadius="12" Padding="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <Binding Path="IsMouseOver"
                                                                             RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Border}, AncestorLevel=1}"/>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding ProgressLabel}"
                                                               FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HoverDetail}"
                                                               FontSize="11" Foreground="#CCFFFFFF"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- リスト表示 -->
                        <StackPanel x:Name="ProjectListSection" Visibility="Collapsed">
                            <!-- ヘッダー行 -->
                            <Border Padding="16,8,16,8"
                                    Background="{StaticResource BgSecondaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="プロジェクト名" Grid.Column="0"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="進捗" Grid.Column="1"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="最終更新" Grid.Column="2"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <!-- リスト行 -->
                            <ItemsControl x:Name="ProjectListItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,10,16,10" Cursor="Hand"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                MouseLeftButtonUp="ProjectCard_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 名前列 -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Bi.StarFill}" Style="{StaticResource BiIconSm}"
                                                          Fill="{StaticResource AccentYellowBrush}" Margin="0,0,6,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}"/>
                                                    <TextBlock Text="{Binding Entry.ProjectName}"
                                                               FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- 進捗列 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="60" Height="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Border CornerRadius="2" Background="{StaticResource BorderBrush}"/>
                                                        <Border CornerRadius="2" Background="{StaticResource AccentGreenBrush}"
                                                                HorizontalAlignment="Left"
                                                                Width="{Binding ProgressRate,
                                                                    Converter={StaticResource PercentToWidthConverter},
                                                                    ConverterParameter=60}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ProgressLabel}"
                                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentGreenBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- 最終更新列 -->
                                                <TextBlock Grid.Column="2" Text="{Binding LastOpenedLabel}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- プロジェクト詳細ドロワー -->
            <Grid x:Name="ProjectDetailOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="10">
                <Border Background="#66000000" MouseLeftButtonUp="CloseDetailPanel_Click"/>
                <Border x:Name="ProjectDetailPanel" Width="520" HorizontalAlignment="Right"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DetailPanelTransform" X="520"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- ドロワーヘッダー -->
                        <Border Grid.Row="0" Padding="16,12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                        Click="CloseDetailPanel_Click" ToolTip="閉じる">
                                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                                </Button>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="フォルダ" FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Border x:Name="ViewToggleSwitch" Width="44" Height="24" CornerRadius="12"
                                            Cursor="Hand" MouseLeftButtonUp="ToggleViewMode_Click">
                                        <Grid>
                                            <Border x:Name="ToggleThumb" Width="20" Height="20" CornerRadius="10"
                                                    Background="White" HorizontalAlignment="Left"
                                                    Margin="2,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="詳細" FontSize="11" VerticalAlignment="Center"
                                               Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="DetailPanelTitle"
                                           FontFamily="Yu Gothic UI" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                        <!-- プロジェクト詳細コンテンツ -->
                        <Border Grid.Row="1" x:Name="ProjectInfoPanel" Visibility="Visible">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel x:Name="ProjectInfoContent"/>
                            </ScrollViewer>
                        </Border>
                        <!-- フォルダツリーコンテンツ -->
                        <Grid Grid.Row="1" x:Name="TreePanel" Visibility="Collapsed" Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" MinWidth="120" MaxWidth="400"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ScrollViewer Padding="6" VerticalScrollBarVisibility="Auto">
                                    <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0"
                                              Foreground="{StaticResource TextPrimaryBrush}"
                                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                                                <Setter Property="ContextMenu" Value="{StaticResource TreeItemContextMenu}"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </ScrollViewer>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                          Background="{StaticResource BorderBrush}"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                          Cursor="SizeWE"/>
                            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Padding="16">
                                    <StackPanel x:Name="DetailPanel">
                                        <TextBlock Text="フォルダまたはファイルを選択してください"
                                                   Foreground="{StaticResource TextDimBrush}" FontSize="14"
                                                   HorizontalAlignment="Center" Margin="0,60,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 新規プロジェクト追加ドロワー（右からスライドイン オーバーレイ） -->
            <Grid x:Name="AddProjectOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
                  Panel.ZIndex="20">
                <!-- 暗幕：クリックで閉じる -->
                <Border Background="#66000000" MouseLeftButtonUp="CancelAddProject_Click"/>

                <!-- スライドパネル本体 -->
                <Border x:Name="AddProjectPanel" Width="500" HorizontalAlignment="Right"
                        Background="{StaticResource BgSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AddPanelTransform" X="500"/>
                    </Border.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20,24,24">

                            <!-- ヘッダー行 -->
                            <DockPanel Margin="0,0,0,20">
                                <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                        ToolTip="閉じる" Click="CancelAddProject_Click">
                                    <Path Data="{StaticResource Bi.XLg}" Style="{StaticResource BiIconSm}"/>
                                </Button>
                                <TextBlock Text="新規プロジェクトの作成"
                                           FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- 表紙画像 -->
                            <TextBlock Text="表紙画像（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Border x:Name="CoverImagePreviewBorder" Height="160" CornerRadius="6"
                                    Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Margin="0,0,0,8" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="CoverImagePlaceholder"
                                               Text="クリックまたは下のボタンで画像を選択"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDimBrush}" FontSize="12"/>
                                    <Image x:Name="CoverImagePreview" Stretch="UniformToFill"
                                           Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Style="{StaticResource SecondaryButton}" Padding="10,5"
                                        Click="BrowseCoverImage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                              Margin="0,0,4,0"/>
                                        <TextBlock Text="画像を選択" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnClearCoverImage" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Margin="8,0,0,0"
                                        Click="ClearCoverImage_Click" Visibility="Collapsed">
                                    <TextBlock Text="クリア"/>
                                </Button>
                            </StackPanel>

                            <!-- プロジェクト名 -->
                            <TextBlock Text="プロジェクト名 *" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewProjName" Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,16"/>

                            <!-- 説明 -->
                            <TextBlock Text="説明（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNewProjDesc" Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,16"/>

                            <!-- フォルダ管理オプション -->
                            <Border Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Border x:Name="FolderMgmtToggleSwitch" DockPanel.Dock="Right"
                                                Width="44" Height="24" CornerRadius="12"
                                                Cursor="Hand" MouseLeftButtonUp="ToggleFolderManagement_Click">
                                            <Grid>
                                                <Border x:Name="FolderMgmtThumb" Width="20" Height="20" CornerRadius="10"
                                                        Background="White" HorizontalAlignment="Left"
                                                        Margin="22,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="フォルダ管理" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDimBrush}">
                                        オンにすると、カテゴリー・タスクに対応したフォルダ構造をプロジェクトフォルダ内に作成・管理します。&#x0a;オフにすると、フォルダ表示機能が無効になります。
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- 保存先フォルダ（フォルダ管理ONの場合のみ表示） -->
                            <StackPanel x:Name="FolderPathSection" Margin="0,0,0,12">
                                <TextBlock Text="保存先フォルダ *" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtNewProjPath" Style="{StaticResource DarkTextBox}"
                                             IsReadOnly="True" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Padding="10,5" Click="BrowseNewProjPath_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Bi.FolderFill}" Style="{StaticResource BiIconSm}"
                                                  Margin="0,0,4,0"/>
                                            <TextBlock Text="参照" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- プロジェクト期間 -->
                            <TextBlock Text="プロジェクト期間（任意）" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewProjStartDate" Style="{StaticResource DarkTextBox}"
                                         Tag="yyyy/MM/dd"/>
                                <TextBlock Grid.Column="1" Text="〜" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox x:Name="TxtNewProjEndDate" Grid.Column="2"
                                         Style="{StaticResource DarkTextBox}" Tag="yyyy/MM/dd"/>
                            </Grid>

                            <!-- ボタン群 -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="作成" Style="{StaticResource PrimaryButton}"
                                        Padding="24,8" Margin="0,0,8,0" Click="CreateProject_Click"/>
                                <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                                        Padding="14,8" Click="CancelAddProject_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 削除進捗エリア -->
        <Border x:Name="DeletionArea" Grid.Row="3" Visibility="Collapsed"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtDeletionProject" Grid.Column="0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,16,0" MaxWidth="260"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="DeletionProgressBar" Grid.Column="1"
                             Height="6" Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource AccentCyanBrush}"/>
                <TextBlock x:Name="TxtDeletionPct" Grid.Column="2"
                           Foreground="{StaticResource AccentCyanBrush}"
                           FontFamily="Consolas" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="8,0,0,0" Text="0%"/>
            </Grid>
        </Border>
    </Grid>
</Page>

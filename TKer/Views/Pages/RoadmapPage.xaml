<Page x:Class="TKer.Views.Pages.RoadmapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,14"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🗺" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="ロードマップ"
                           FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="20"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="3"
                        Background="{StaticResource BorderBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="試用" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- メインエリア（縦ツールバー + コンテンツ） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 縦ツールバー -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                    <Button x:Name="BtnEdit" Style="{StaticResource VToolbarBtn}"
                            ToolTip="編集 (F2)" Click="Edit_Click" IsEnabled="False">
                        <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button Style="{StaticResource VToolbarBtn}"
                            ToolTip="項目を追加 (Ctrl+Shift+;)" Click="Add_Click">
                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button x:Name="BtnDelete" Style="{StaticResource VToolbarBtn}"
                            ToolTip="選択中の項目を削除 (Ctrl+-)" Click="Delete_Click" IsEnabled="False">
                        <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- コンテンツ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Padding="24,20"
                          MouseLeftButtonDown="OuterArea_MouseLeftButtonDown">
                <StackPanel>
                    <Border x:Name="NoItemBanner" Visibility="Collapsed"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="24,20" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🗺" FontSize="40"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="ロードマップ項目がありません"
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="左の「＋」から項目を追加できます"
                                       FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="GroupsPanel"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

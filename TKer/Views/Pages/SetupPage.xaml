<Page x:Class="TKer.Views.Pages.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="580" Margin="0,40,0,40" HorizontalAlignment="Center">

            <!-- ロゴ -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40">
                <TextBlock Text="TKer" FontFamily="Yu Gothic UI" FontWeight="Black"
                           FontSize="42" Foreground="{StaticResource AccentCyanBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="プロジェクト・タスク管理システム" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>


            <!-- 現在のプロジェクト -->
            <Border x:Name="CurrentProjectBanner" Margin="0,0,0,16"
                    Background="#143D7EFF"
                    BorderBrush="#4C3D7EFF" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconSm}"
                              Margin="0,0,5,0"/>
                        <TextBlock Text="現在のプロジェクト:"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCurrentProject"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource AccentCyanBrush}"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <!-- 新規作成 -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIcon}"
                              Fill="{StaticResource AccentBlueBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="新規プロジェクト作成"
                                   FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="作成先フォルダ" Style="{StaticResource FormLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBasePath" Style="{StaticResource DarkTextBox}"
                                 Tag="フォルダを選択してください"/>
                        <Button Grid.Column="1" Content="参照..." Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowseBasePath_Click"/>
                    </Grid>

                    <TextBlock Text="プロジェクト名" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtProjectName" Style="{StaticResource DarkTextBox}"
                             Margin="0,0,0,14" Tag="例: MyProject_2025"/>

                    <TextBlock Text="説明 (省略可)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TxtDescription" Style="{StaticResource DarkTextBox}"
                             Margin="0,0,0,20" Height="70" TextWrapping="Wrap"
                             AcceptsReturn="True" Tag="プロジェクトの概要を入力"/>

                    <Button Content="プロジェクトを作成" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Click="CreateProject_Click"/>
                </StackPanel>
            </Border>

            <!-- 既存を開く -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIcon}"
                              Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="既存プロジェクトを開く"
                                   FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="project_data.json を選択してプロジェクトを読み込みます"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               Margin="0,0,0,14"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="OpenProject_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.Folder2Open}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="プロジェクトを開く" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>


            <!-- プロジェクト設定編集 -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{StaticResource Bi.GearFill}" Style="{StaticResource BiIcon}"
                              Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="プロジェクト設定を編集"
                                   FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="現在開いているプロジェクトの名前・説明・バージョン・管理者を変更します。"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="EditProjectSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.GearFill}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="プロジェクト設定を編集" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Excel インポート -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{StaticResource Bi.FileEarmarkSpreadsheet}" Style="{StaticResource BiIcon}"
                              Fill="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="WBS/ガントチャートからインポート"
                                   FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="既存のExcelファイル（WBS_ガントチャート形式）からタスクをインポートします。プロジェクトを開いた後に実行してください。"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="ImportExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.FileEarmarkSpreadsheet}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="Excelからインポート" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

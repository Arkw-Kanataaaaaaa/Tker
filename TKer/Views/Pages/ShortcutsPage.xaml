<Page x:Class="TKer.Views.Pages.ShortcutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,14" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Bi.LightningFill}" Style="{StaticResource BiIcon}"
                          Fill="{StaticResource AccentYellowBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="ショートカット管理" FontFamily="Yu Gothic UI" FontWeight="Bold"
                               FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="＋ ショートカット追加"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,5" FontSize="12"
                        Click="AddShortcut_Click"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <Border x:Name="NoItemBanner" Visibility="Collapsed"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource Bi.LightningFill}" Style="{StaticResource BiIconXl}"
                              Fill="{StaticResource AccentYellowBrush}"
                              HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="ショートカットが登録されていません"
                                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="「＋ ショートカット追加」からアプリ・ファイル・URLを登録できます"
                                   FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ShortcutList"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<Page x:Class="TKer.Views.Pages.TableListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,12">
            <DockPanel>
                <TextBlock Text="表作成ツール" FontFamily="Yu Gothic UI" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Excel出力 -->
                    <Button x:Name="BtnExcel" Style="{StaticResource SecondaryButton}"
                            Padding="10,5,10,5" Margin="0,0,8,0"
                            Click="ExportExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.FileEarmarkSpreadsheet}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,5,0"/>
                            <TextBlock Text="Excel出力" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <!-- テーブル削除 -->
                    <Button x:Name="BtnDeleteTable" Style="{StaticResource SecondaryButton}"
                            Padding="10,5,10,5" Margin="0,0,8,0"
                            Click="DeleteTable_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.Trash3}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,5,0"/>
                            <TextBlock Text="テーブル削除" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <!-- テーブル編集 -->
                    <Button x:Name="BtnEditTable" Style="{StaticResource SecondaryButton}"
                            Padding="10,5,10,5" Margin="0,0,8,0"
                            Click="EditTable_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.PencilSquare}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,5,0"/>
                            <TextBlock Text="列編集" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <!-- 新規テーブル -->
                    <Button Content="＋ 新規テーブル"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,5,12,5" Margin="0,0,12,0"
                            Click="NewTable_Click"/>
                    <!-- テーブル選択 -->
                    <TextBlock Text="テーブル:" Foreground="{StaticResource TextDimBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="TableSelector" Width="160"
                              Background="{StaticResource BgSecondaryBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              SelectionChanged="TableSelector_Changed"
                              DisplayMemberPath="Name"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 行操作バー -->
        <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Padding="10,4,10,4" Margin="0,0,6,0"
                            Click="AddRow_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconSm}"
                                  Fill="{StaticResource AccentBlueBrush}" Margin="0,0,4,0"/>
                            <TextBlock Text="行追加" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDeleteRow" Style="{StaticResource SecondaryButton}"
                            Padding="10,4,10,4" Margin="0,0,6,0"
                            Click="DeleteRow_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.Trash3}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,4,0"/>
                            <TextBlock Text="行削除" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSearch" Style="{StaticResource SecondaryButton}"
                            Padding="10,4,10,4"
                            Click="ToggleSearch_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Bi.Search}" Style="{StaticResource BiIconSm}"
                                  Margin="0,0,4,0"/>
                            <TextBlock Text="検索" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 検索バー -->
                <Border x:Name="SearchBar" DockPanel.Dock="Right"
                        Visibility="Collapsed" Width="220">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}"
                             Height="28" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="2">
            <!-- テーブルなし -->
            <StackPanel x:Name="NoTableBanner" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Visibility="Visible">
                <Path Data="{StaticResource Bi.Table}" Style="{StaticResource BiIconXl}"
                      Fill="{StaticResource TextDimBrush}"
                      HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="テーブルがありません" FontSize="16"
                           Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="「＋ 新規テーブル」からテーブルを作成してください"
                           FontSize="12" Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid x:Name="TableGrid"
                      Visibility="Collapsed"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                      Background="{StaticResource BgCardBrush}"
                      RowBackground="{StaticResource BgCardBrush}"
                      AlternatingRowBackground="{StaticResource BgSecondaryBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderThickness="0"
                      ColumnHeaderHeight="36"
                      RowHeight="32"
                      CellEditEnding="TableGrid_CellEditEnding">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2B5797"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A6E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
    </Grid>
</Page>

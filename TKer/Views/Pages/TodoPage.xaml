<Page x:Class="TKer.Views.Pages.TodoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TODO"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- ツールバー -->
            <RowDefinition Height="*"/>    <!-- コンテンツ -->
        </Grid.RowDefinitions>

        <!-- ══ ツールバー ══ -->
        <Border x:Name="PageHeader" Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,8">
                <!-- 統計バッジ -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A3A6E" CornerRadius="4" Padding="8,3" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtTotalCount" Text="0" FontWeight="Bold"
                                       Foreground="#3D7EFF" FontSize="13"/>
                            <TextBlock Text=" 件" Foreground="{DynamicResource TextDimBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A3A1A" CornerRadius="4" Padding="8,3" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtDoneCount" Text="0" FontWeight="Bold"
                                       Foreground="#4CAF50" FontSize="13"/>
                            <TextBlock Text=" 完了" Foreground="{DynamicResource TextDimBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#3A1A1A" CornerRadius="4" Padding="8,3" Margin="4,0,0,0"
                            Visibility="{Binding ElementName=TxtOverdueCount, Path=Text, Converter={StaticResource ZeroCollapsedConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtOverdueCount" Text="0" FontWeight="Bold"
                                       Foreground="#F44336" FontSize="13"/>
                            <TextBlock Text=" 期限超過" Foreground="{DynamicResource TextDimBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 左側操作 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 TODO" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnAdd" Content="＋ 追加" Style="{StaticResource PrimaryButton}"
                            Padding="12,5" Click="BtnAdd_Click" FontSize="12"/>
                    <Border Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Margin="8,0,0,0" Padding="6,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.6"/>
                            <TextBox x:Name="TxtSearch" Width="160" Background="Transparent"
                                     BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center" TextChanged="TxtSearch_Changed"
                                     ToolTip="キーワード検索"/>
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="CboFilter" Margin="8,0,0,0" Width="110"
                              SelectionChanged="CboFilter_Changed" FontSize="12">
                        <ComboBoxItem Content="すべて" IsSelected="True"/>
                        <ComboBoxItem Content="未完了のみ"/>
                        <ComboBoxItem Content="完了済みのみ"/>
                        <ComboBoxItem Content="期限超過"/>
                        <ComboBoxItem Content="今日期限"/>
                        <ComboBoxItem Content="繰り返しあり"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ TODOリスト ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TodoPanel" Margin="12,8,12,8"/>
        </ScrollViewer>
    </Grid>
</Page>

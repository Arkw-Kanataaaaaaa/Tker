<Page x:Class="TKer.Views.Pages.UiCustomizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="UiTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Yu Gothic UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{StaticResource AccentCyanBrush}"
                                BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource BgSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Yu Gothic UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Padding="24,12"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="UIカスタマイズ"
                       FontFamily="Yu Gothic UI" FontWeight="Bold" FontSize="18"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </Border>

        <!-- ══ タブコントロール ══ -->
        <TabControl Grid.Row="1" x:Name="MainTabs"
                    Background="Transparent" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderBrush}">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
                </Style>
            </TabControl.Resources>

            <!-- ─── Tab 1: ホーム画面レイアウト ─── -->
            <TabItem Header="🏠 ホーム画面" Style="{StaticResource UiTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左: 仮想ウィンドウのホーム画面プレビュー -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ヒントバー＋レーン操作ツールバー -->
                        <StackPanel Grid.Row="0">
                            <Border Background="{StaticResource BgSecondaryBrush}"
                                    Padding="14,7"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap">
                                    <Run Text="⠿ ハンドルでドラッグして別セルへ"/>
                                    <Run Text="　/　"/>
                                    <Run Text="レーン境界をドラッグでサイズ変更"/>
                                    <Run Text="　/　"/>
                                    <Run Text="🎨 色　👁 表示"/>
                                </TextBlock>
                            </Border>
                            <Border Background="{StaticResource BgSecondaryBrush}"
                                    Padding="10,6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="＋ 列" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                            Click="LaneAddCol_Click"/>
                                    <Button Content="− 列" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="0,0,12,0"
                                            Click="LaneRemoveCol_Click"/>
                                    <Button Content="＋ 行" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                            Click="LaneAddRow_Click"/>
                                    <Button Content="− 行" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="0,0,12,0"
                                            Click="LaneRemoveRow_Click"/>
                                    <Button Content="リセット" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11"
                                            Click="LaneReset_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 仮想ウィンドウ枠（ホーム画面プレビュー） -->
                        <Border Grid.Row="1" Margin="20,18,20,22" CornerRadius="10"
                                Background="#161616"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.55"/>
                            </Border.Effect>
                            <DockPanel>
                                <!-- 疑似タイトルバー -->
                                <Border DockPanel.Dock="Top" Height="34"
                                        Background="{StaticResource BgSecondaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <Ellipse Width="11" Height="11" Margin="0,0,7,0" Fill="#FF5F57"/>
                                            <Ellipse Width="11" Height="11" Margin="0,0,7,0" Fill="#FEBC2E"/>
                                            <Ellipse Width="11" Height="11" Fill="#28C840"/>
                                        </StackPanel>
                                        <TextBlock Text="TKer — ホーム" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- 配置領域 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <Grid x:Name="HomePreviewGrid" Margin="14" MinHeight="380"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 右: テンプレート選択 + 選択コンポーネントのスタイル -->
                    <Border Grid.Column="1"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,20,16,20">
                                <!-- テンプレート（スタイル）選択 -->
                                <TextBlock Text="スタイル" Style="{StaticResource SectionHeading}"/>
                                <RadioButton x:Name="RbTplGrid" Content="グリッド" GroupName="HomeTpl"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="0,4,0,4" Checked="HomeTemplate_Changed"/>
                                <RadioButton x:Name="RbTplPlanet" Content="🪐 惑星（テスト）" GroupName="HomeTpl"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="0,4,0,4" Checked="HomeTemplate_Changed"/>
                                <RadioButton x:Name="RbTplCard" Content="🗂 カード（テスト）" GroupName="HomeTpl"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="0,4,0,4" Checked="HomeTemplate_Changed"/>
                                <TextBlock x:Name="TplHint" Margin="0,6,0,0" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>

                                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}"/>

                                <!-- 選択コンポーネントのスタイル -->
                                <StackPanel x:Name="HomeStylePanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─── Tab 2: その他の画面 ─── -->
            <TabItem Header="🖥 各画面の個別設定" Style="{StaticResource UiTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentPanel" Margin="24,20,24,28" MaxWidth="700"/>
                </ScrollViewer>
            </TabItem>

            <!-- ─── Tab 3: ツールバー ─── -->
            <TabItem Header="☰ ツールバー" Style="{StaticResource UiTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,28" MaxWidth="500">

                        <TextBlock Text="ツールバー順序" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="メニュー項目を選択して ▲▼ ボタンで表示順を変更します"
                                   FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,14"/>

                        <Border Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" MinHeight="60">
                            <ListBox x:Name="TbListBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="14,10"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="▲ 上へ" Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" FontSize="12" Margin="0,0,8,0"
                                    Click="TbMoveUp_Click"/>
                            <Button Content="▼ 下へ" Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" FontSize="12"
                                    Click="TbMoveDown_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── Tab 4: テーマ ─── -->
            <TabItem Header="🎨 テーマ・一括設定" Style="{StaticResource UiTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20,24,28" MaxWidth="560">

                        <!-- ══ プリセット ══ -->
                        <TextBlock Text="テーマプリセット" Style="{StaticResource SectionHeading}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="プリセットを適用すると、テーマカラーと各画面コンポーネントのスタイルをまとめて切り替えます。"/>
                            <LineBreak/>
                            <Run Text="ユーザープリセットは現在の全設定（カラー・各画面スタイル）を記録します。"/>
                        </TextBlock>

                        <!-- プリセットカードエリア（CS で動的生成） -->
                        <StackPanel x:Name="PresetPanel" Margin="0,0,0,10"/>

                        <!-- 現在の設定を保存 -->
                        <Button x:Name="BtnSavePreset" Click="SavePreset_Click"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="現在の設定をプリセットとして保存" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,20,0,20" Background="{StaticResource BorderBrush}"/>

                        <!-- ══ 一括スタイル適用 ══ -->
                        <TextBlock Text="一括スタイル適用" Style="{StaticResource SectionHeading}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="「各画面の個別設定」タブにあるすべてのコンポーネントに同じスタイルを一括で適用します。"/>
                            <LineBreak/>
                            <Run Text="空欄の色項目は変更しません。透明度は常に適用されます。"/>
                        </TextBlock>

                        <Border Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="背景色" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtBulkBgColor"
                                             Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"
                                             TextChanged="BulkBg_TextChanged"/>
                                    <Border Grid.Row="0" Grid.Column="2" x:Name="BulkBgPreview"
                                            Width="22" Height="22" CornerRadius="4"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Margin="8,0,0,8" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="文字色" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtBulkTextColor"
                                             Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"
                                             TextChanged="BulkText_TextChanged"/>
                                    <Border Grid.Row="1" Grid.Column="2" x:Name="BulkTextPreview"
                                            Width="22" Height="22" CornerRadius="4"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Margin="8,0,0,8" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="枠線色" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtBulkBorderColor"
                                             Style="{StaticResource DarkTextBox}"
                                             TextChanged="BulkBorder_TextChanged"/>
                                    <Border Grid.Row="2" Grid.Column="2" x:Name="BulkBorderPreview"
                                            Width="22" Height="22" CornerRadius="4"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="透明度" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderBulkOpacity" Minimum="0" Maximum="100" Value="100"
                                            VerticalAlignment="Center"
                                            ValueChanged="SliderBulkOpacity_Changed"
                                            Foreground="{StaticResource AccentCyanBrush}"/>
                                    <TextBlock x:Name="LblBulkOpacity" Grid.Column="1" Text="100%"
                                               FontSize="12" FontFamily="Consolas"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <Button Click="BulkApply_Click"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch" Padding="14,7">
                                    <TextBlock Text="全コンポーネントに一括適用" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,12,0,24" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="テーマカラー設定" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="HEXカラーコードで入力（例: #CFCFCF）。空欄はデフォルト色。「保存」ボタンで反映されます。"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="メインテキスト色" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtColorTextPrimary" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Text="サブテキスト色"   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtColorTextSecond"  Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Text="アクセント色"     FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtColorAccent"       Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="3" Text="ヘッダー背景色"   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtColorBgSecond"     Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="4" Text="カード背景色"     FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtColorBgCard"       Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="5" Text="ボーダー色"       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TxtColorBorder"       Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                        </Grid>

                        <TextBlock Text="ボタン色" Style="{StaticResource SectionHeading}" Margin="0,8,0,4"/>
                        <TextBlock Text="空欄はデフォルト色。ホバー色は設定した背景色を自動で暗くした色になります"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ボタン背景色" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtColorButtonBg"     Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Text="ボタン枠線色" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtColorButtonBorder" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Text="ドロップダウン背景色" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtColorDropdownBg"   Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>
                        </Grid>

                        <Separator Margin="0,16,0,20" Background="{StaticResource BorderBrush}"/>
                        <TextBlock Text="フォント" Style="{StaticResource SectionHeading}"/>
                        <ComboBox x:Name="CbFontFamily" Style="{StaticResource DarkComboBox}"
                                  Margin="0,0,0,4" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="（デフォルト）" Tag=""/>
                            <ComboBoxItem Content="Yu Gothic UI"  Tag="Yu Gothic UI"/>
                            <ComboBoxItem Content="Meiryo UI"     Tag="Meiryo UI"/>
                            <ComboBoxItem Content="メイリオ"      Tag="メイリオ"/>
                            <ComboBoxItem Content="MS Gothic"     Tag="MS Gothic"/>
                            <ComboBoxItem Content="BIZ UDGothic"  Tag="BIZ UDGothic"/>
                            <ComboBoxItem Content="Segoe UI"      Tag="Segoe UI"/>
                        </ComboBox>
                        <TextBlock Text="※ フォント変更は再起動後に完全適用されます"
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- フッター: 保存 -->
        <Border Grid.Row="2" Padding="20,10"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource DangerButton}"
                        Padding="14,6" FontSize="12"
                        Click="ResetAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Bi.ArrowClockwise}" Style="{StaticResource BiIconSm}"
                              Margin="0,0,5,0"/>
                        <TextBlock Text="全カスタマイズをリセット" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,7" HorizontalAlignment="Right"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Bi.Floppy}" Style="{StaticResource BiIconSm}"
                              Fill="White" Margin="0,0,6,0"/>
                        <TextBlock Text="保存" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Page>

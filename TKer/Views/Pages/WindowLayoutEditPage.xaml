<Page x:Class="TKer.Views.Pages.WindowLayoutEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー: パンくずリスト -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,14"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ウィンドウレイアウト" FontWeight="Bold" FontSize="18"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Cursor="Hand"
                           ToolTip="ウィンドウレイアウト一覧へ戻る"
                           MouseLeftButtonUp="LayoutCrumb_Click"/>
                <TextBlock Text="›" FontWeight="Bold" FontSize="18"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="10,0,10,0"/>
                <TextBlock x:Name="HeaderTitle" Text="ウィンドウレイアウト追加"
                           FontWeight="Bold" FontSize="18"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- メインエリア（縦ツールバー + 仮想デスクトップ + 右パネル） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ─── 縦ツールバー ─── -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                    <Button Style="{StaticResource VToolbarBtn}"
                            ToolTip="スナップ追加" Click="AddSnap_Click">
                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button x:Name="BtnDeleteSnap" Style="{StaticResource VToolbarBtn}"
                            ToolTip="選択中のスナップを削除" IsEnabled="False"
                            Click="DeleteSnap_Click">
                        <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button Style="{StaticResource VToolbarBtn}"
                            ToolTip="配置されたスナップをすべて削除（初期化）"
                            Click="ResetSnaps_Click">
                        <Path Data="{StaticResource Bi.ArrowClockwise}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ─── 仮想デスクトップ ─── -->
            <Grid Grid.Column="1" Background="#1f1f24"
                  MouseLeftButtonDown="OuterArea_MouseLeftButtonDown">
                <Viewbox Stretch="Uniform" Margin="32">
                    <Border BorderBrush="#666" BorderThickness="2" Background="#0d0f14">
                        <Canvas x:Name="EditorCanvas" Background="Transparent" ClipToBounds="True"
                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
                    </Border>
                </Viewbox>
            </Grid>

            <!-- ─── 右パネル ─── -->
            <Border Grid.Column="2" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- 保存ボタン（最下部） -->
                    <Border DockPanel.Dock="Bottom" Padding="20,14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Button Content="保存"
                                Style="{StaticResource PrimaryButton}"
                                Padding="32,10" FontSize="15" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                Click="Save_Click"/>
                    </Border>

                    <!-- 名前・説明（保存の上） -->
                    <Border DockPanel.Dock="Bottom" Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="レイアウト名 *" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,12"/>
                            <TextBlock Text="説明" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDescription" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- 設定トグル（名前の上） -->
                    <Border DockPanel.Dock="Bottom" Padding="20,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Border x:Name="MinimizeToggleSwitch" DockPanel.Dock="Right"
                                    Width="44" Height="24" CornerRadius="12"
                                    Background="{StaticResource BorderBrush}"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    MouseLeftButtonUp="ToggleMinimize_Click">
                                <Grid>
                                    <Border x:Name="MinimizeToggleThumb" Width="20" Height="20"
                                            CornerRadius="10" Background="White"
                                            HorizontalAlignment="Left"
                                            Margin="2,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="他ウィンドウを最小化"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="このレイアウト適用前に他の起動中ウィンドウをすべて最小化"
                                           FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 起動中アプリ一覧（上部、残り領域を埋める） -->
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="20,12"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource VToolbarBtn}"
                                        Width="28" Height="28"
                                        ToolTip="一覧を更新" Click="RefreshApps_Click">
                                    <Path Data="{StaticResource Bi.ArrowClockwise}"
                                          Style="{StaticResource BiIconSm}"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="起動中のアプリ"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="ドラッグしてスナップにドロップ"
                                               FontSize="10"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="RunningAppsList" Background="Transparent"
                                 BorderThickness="0" Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonDown="RunningAppsList_PreviewMouseDown"
                                 PreviewMouseMove="RunningAppsList_PreviewMouseMove"/>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

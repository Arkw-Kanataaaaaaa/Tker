<Page x:Class="TKer.Views.Pages.WindowLayoutEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Focusable="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー: パンくずリスト -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,14"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ウィンドウレイアウト" FontWeight="Bold" FontSize="18"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Cursor="Hand"
                           ToolTip="ウィンドウレイアウト一覧へ戻る"
                           MouseLeftButtonUp="LayoutCrumb_Click"/>
                <TextBlock Text="›" FontWeight="Bold" FontSize="18"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="10,0,10,0"/>
                <TextBlock x:Name="HeaderTitle" Text="ウィンドウレイアウト追加"
                           FontWeight="Bold" FontSize="18"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- メインエリア（仮想デスクトップ + 右パネル） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ─── 中央: 仮想デスクトップ ─── -->
            <Grid Grid.Column="0" Background="#1f1f24"
                  MouseLeftButtonDown="OuterArea_MouseLeftButtonDown">
                <Viewbox Stretch="Uniform" Margin="32">
                    <Border x:Name="DesktopBg" BorderBrush="#666" BorderThickness="2"
                            Background="#0d0f14">
                        <Canvas x:Name="EditorCanvas" Background="Transparent" ClipToBounds="True"
                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
                    </Border>
                </Viewbox>
            </Grid>

            <!-- ─── 右パネル ─── -->
            <Border Grid.Column="1" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- 最下部: キャンセル・保存・テスト適用 -->
                    <Border DockPanel.Dock="Bottom" Padding="20,14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" Margin="0,0,8,0"
                                    Click="Cancel_Click"/>
                            <Button x:Name="BtnSave" Content="保存"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="22,6" Margin="0,0,8,0"
                                    Click="Save_Click"/>
                            <Button x:Name="BtnTestApply" Content="テスト適用"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" IsEnabled="False"
                                    Click="TestApply_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- その上: 設定情報セクション（名前 / 説明 / 設定） -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource BgPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,12"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="設定情報"
                                           FontFamily="Yu Gothic UI"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                            <StackPanel Margin="20,14">
                                <TextBlock Text="レイアウト名 *" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="説明" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDescription" Style="{StaticResource DarkTextBox}"
                                         Margin="0,0,0,12"/>

                                <!-- 設定（説明の下） -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                        Padding="0,12,0,0">
                                    <DockPanel>
                                        <Border x:Name="MinimizeToggleSwitch" DockPanel.Dock="Right"
                                                Width="44" Height="24" CornerRadius="12"
                                                Background="{StaticResource BorderBrush}"
                                                Cursor="Hand" VerticalAlignment="Center"
                                                MouseLeftButtonUp="ToggleMinimize_Click">
                                            <Grid>
                                                <Border x:Name="MinimizeToggleThumb" Width="20" Height="20"
                                                        CornerRadius="10" Background="White"
                                                        HorizontalAlignment="Left"
                                                        Margin="2,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="全ウィンドウ最小化後、レイアウト適用"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 最上部: パターン選択 -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource BgPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,12"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="パターン選択"
                                           FontFamily="Yu Gothic UI"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                            <StackPanel x:Name="PatternList" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,12,0,12"/>
                        </DockPanel>
                    </Border>

                    <!-- 下に詰めずに残り領域: 起動中アプリ一覧 -->
                    <Border Background="{StaticResource BgPrimaryBrush}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="20,12"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="起動中のアプリ"
                                               FontFamily="Yu Gothic UI"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="ドラッグしてスナップにドロップ"
                                               FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="RunningAppsList" Background="Transparent"
                                     BorderThickness="0" Padding="6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PreviewMouseLeftButtonDown="RunningAppsList_PreviewMouseDown"
                                     PreviewMouseMove="RunningAppsList_PreviewMouseMove"/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

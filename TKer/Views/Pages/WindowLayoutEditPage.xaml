<Page x:Class="TKer.Views.Pages.WindowLayoutEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー: パンくずリスト -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,14"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ウィンドウレイアウト" FontWeight="Bold" FontSize="18"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Cursor="Hand"
                           ToolTip="ウィンドウレイアウト一覧へ戻る"
                           MouseLeftButtonUp="LayoutCrumb_Click"/>
                <TextBlock Text="›" FontWeight="Bold" FontSize="18"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="10,0,10,0"/>
                <TextBlock x:Name="HeaderTitle" Text="ウィンドウレイアウト追加"
                           FontWeight="Bold" FontSize="18"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- メインエリア（縦ツールバー + 仮想デスクトップ + フッター） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── 縦ツールバー（スナップ追加・削除・初期化） ─── -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                    <Button Style="{StaticResource VToolbarBtn}"
                            ToolTip="スナップ追加" Click="AddSnap_Click">
                        <Path Data="{StaticResource Bi.PlusLg}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Button x:Name="BtnDeleteSnap" Style="{StaticResource VToolbarBtn}"
                            ToolTip="選択中のスナップを削除" IsEnabled="False"
                            Click="DeleteSnap_Click">
                        <Path Data="{StaticResource Bi.Dash}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                    <Separator Margin="8,4" Background="{StaticResource BorderBrush}"/>
                    <Button Style="{StaticResource VToolbarBtn}"
                            ToolTip="配置されたスナップをすべて削除（初期化）"
                            Click="ResetSnaps_Click">
                        <Path Data="{StaticResource Bi.ArrowClockwise}" Style="{StaticResource BiIconLg}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ─── 右側エリア: 仮想デスクトップ + フッター ─── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 仮想デスクトップ表示エリア -->
                <Grid Grid.Row="0" Background="#1f1f24"
                      MouseLeftButtonDown="OuterArea_MouseLeftButtonDown">
                    <Viewbox Stretch="Uniform" Margin="32">
                        <Border BorderBrush="#666" BorderThickness="2" Background="#0d0f14">
                            <Canvas x:Name="EditorCanvas" Background="Transparent" ClipToBounds="True"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
                        </Border>
                    </Viewbox>
                </Grid>

                <!-- フッター: レイアウト名・説明 + 保存ボタン -->
                <Border Grid.Row="1" Padding="24,16"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 名前 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="レイアウト名 *" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>

                        <!-- 説明 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="説明" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDescription" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>

                        <!-- 保存 -->
                        <Button Grid.Column="4" Content="保存"
                                Style="{StaticResource PrimaryButton}"
                                Padding="26,6"
                                VerticalAlignment="Bottom"
                                Click="Save_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>

<Page x:Class="TKer.Views.Pages.WindowLayoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border x:Name="PageHeader" Grid.Row="0" Padding="24,14"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🪟" FontSize="18" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="ウィンドウレイアウト" FontFamily="Yu Gothic UI"
                               FontWeight="Bold" FontSize="20"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="＋ 現在の配置を保存"
                        Padding="12,5" FontSize="12"
                        Background="{DynamicResource AccentCyanBrush}"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="SaveCurrent_Click"/>
            </DockPanel>
        </Border>

        <!-- コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <Border x:Name="NoItemBanner" Visibility="Collapsed"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🪟" FontSize="40"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="ウィンドウレイアウトが保存されていません"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="現在のデスクトップ上のウィンドウ配置を保存し、後で復元できます"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="LayoutGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

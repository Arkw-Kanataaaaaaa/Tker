<Window x:Class="TKer.Views.Widgets.BookmarkWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Height"
        Width="52"
        Closing="Widget_Closing">

    <Window.Resources>
        <!-- ツールボタンスタイル -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 栞タブ + 展開パネル（左に展開） -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>       <!-- 展開パネル（左） -->
            <ColumnDefinition Width="Auto"/>    <!-- 栞タブ（右、常に表示） -->
        </Grid.ColumnDefinitions>

        <!-- ═══ 展開パネル（タブの左側に表示） ═══ -->
        <Border x:Name="ExpandPanel" Grid.Column="0"
                Background="#E81A1F2E"
                BorderBrush="#3A4560" BorderThickness="1,1,0,1"
                CornerRadius="12,0,0,12"
                Width="280"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- パネルヘッダー -->
                <Border Grid.Row="0" Background="#141926"
                        CornerRadius="12,0,0,0" Padding="12,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="10"
                                Style="{StaticResource ToolBtn}"
                                Width="22" Height="22" Click="BtnClosePanel_Click"
                                Foreground="#9AA0B5"/>
                        <TextBlock Text="🔖 ウィジェットランチャー" FontSize="12"
                                   FontWeight="Bold" Foreground="#CFCFCF"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- コンテンツスクロール -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              MaxHeight="500">
                    <StackPanel x:Name="PanelContent" Margin="10,8,10,10"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ 栞タブ（右端、自由移動可能） ═══ -->
        <Border Grid.Column="1" x:Name="TabBorder"
                Background="#CC1A1F2E"
                BorderBrush="#3A4560" BorderThickness="1"
                CornerRadius="0,10,10,0"
                Cursor="Hand"
                MouseLeftButtonDown="Tab_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel x:Name="TabPanel" Margin="6,0,6,8">

                <!-- ══ ドラッグハンドル（タブ最上部、全幅） ══ -->
                <!-- ここをドラッグするとウィジェット全体を自由に移動できます -->
                <Border x:Name="DragHandle"
                        Height="24" Margin="-6,0,-6,4"
                        Background="#18FFFFFF"
                        CornerRadius="0,10,0,0"
                        Cursor="SizeAll"
                        ToolTip="ドラッグして自由に移動"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                    <!-- 3 つの横点でグリップを視覚化 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="#4A5880" Margin="1.5,0"/>
                        <Ellipse Width="3" Height="3" Fill="#4A5880" Margin="1.5,0"/>
                        <Ellipse Width="3" Height="3" Fill="#4A5880" Margin="1.5,0"/>
                    </StackPanel>
                </Border>

                <!-- ══ ツールアイコン群 ══ -->
                <Button x:Name="BtnTodo"     Style="{StaticResource ToolBtn}" Click="BtnTodo_Click"     ToolTip="TODO一覧・追加">
                    <TextBlock Text="📋" FontSize="16"/>
                </Button>
                <Button x:Name="BtnNote"     Style="{StaticResource ToolBtn}" Click="BtnNote_Click"     ToolTip="クイックメモ" Margin="0,2,0,0">
                    <TextBlock Text="📝" FontSize="16"/>
                </Button>
                <Button x:Name="BtnPomodoro" Style="{StaticResource ToolBtn}" Click="BtnPomodoro_Click" ToolTip="ポモドーロ" Margin="0,2,0,0">
                    <TextBlock Text="⏱" FontSize="16"/>
                </Button>
                <Button x:Name="BtnTask"     Style="{StaticResource ToolBtn}" Click="BtnTask_Click"     ToolTip="タスク一覧" Margin="0,2,0,0">
                    <TextBlock Text="📌" FontSize="16"/>
                </Button>
                <Button x:Name="BtnCalendar" Style="{StaticResource ToolBtn}" Click="BtnCalendar_Click" ToolTip="カレンダー" Margin="0,2,0,0">
                    <TextBlock Text="📆" FontSize="16"/>
                </Button>

                <!-- セパレーター -->
                <Border Height="1" Background="#3A4560" Margin="4,6,4,6"/>

                <!-- ══ パネル開閉トグル ══ -->
                <!-- ◀ = パネルを左に展開 ／ ▶ = パネルを閉じる -->
                <Button x:Name="BtnToggle" Style="{StaticResource ToolBtn}"
                        Click="BtnToggle_Click" ToolTip="パネルを開く / 閉じる">
                    <TextBlock x:Name="TxtToggle" Text="◀" FontSize="11"
                               Foreground="#9AA0B5" FontWeight="SemiBold"/>
                </Button>

                <!-- ウィジェット非表示ボタン -->
                <Button x:Name="BtnClose" Style="{StaticResource ToolBtn}"
                        Click="BtnCloseWidget_Click" ToolTip="ウィジェットを隠す" Margin="0,2,0,0">
                    <TextBlock Text="✕" FontSize="11" Foreground="#6A7085"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

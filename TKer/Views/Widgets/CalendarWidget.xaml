<Window x:Class="TKer.Views.Widgets.CalendarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MinWidth="180" MinHeight="210"
        LocationChanged="Widget_LocationChanged"
        SizeChanged="Widget_SizeChanged"
        Closing="Widget_Closing">

    <Window.Resources>
        <!-- 共通ボタンスタイル（ウィジェット専用: シンプルなゴースト） -->
        <Style x:Key="WgBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="0"/>
            <Setter Property="FontFamily"   Value="Yu Gothic UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ルートボーダー（背景・角丸・ボーダー） -->
    <Border x:Name="RootBorder" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>   <!-- ヘッダー -->
                <RowDefinition Height="Auto"/> <!-- 曜日ヘッダー -->
                <RowDefinition Height="*"/>    <!-- カレンダーグリッド -->
                <RowDefinition Height="14"/>   <!-- リサイズグリップ -->
            </Grid.RowDefinitions>

            <!-- ═══ ヘッダー（ドラッグ領域） ═══ -->
            <Grid Grid.Row="0" x:Name="HeaderGrid"
                  MouseLeftButtonDown="Header_MouseDown"
                  Cursor="SizeAll">

                <!-- 月 ナビ -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Margin="8,0,0,0">
                    <Button x:Name="BtnPrev" Width="20" Height="20"
                            Style="{StaticResource WgBtn}" Click="BtnPrev_Click">
                        <TextBlock x:Name="TxtPrevIcon" Text="◀" FontSize="9"/>
                    </Button>
                    <TextBlock x:Name="TxtMonthYear"
                               VerticalAlignment="Center" Margin="5,0"
                               FontWeight="Bold"/>
                    <Button x:Name="BtnNext" Width="20" Height="20"
                            Style="{StaticResource WgBtn}" Click="BtnNext_Click">
                        <TextBlock x:Name="TxtNextIcon" Text="▶" FontSize="9"/>
                    </Button>
                </StackPanel>

                <!-- アクションボタン -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <Button x:Name="BtnPinIcon" Width="24" Height="24"
                            Style="{StaticResource WgBtn}" Click="BtnPin_Click"
                            ToolTip="最前面/デスクトップ切替">
                        <TextBlock x:Name="TxtPinIcon" Text="📌" FontSize="11"/>
                    </Button>
                    <Button x:Name="BtnSettings" Width="24" Height="24"
                            Style="{StaticResource WgBtn}" Click="BtnSettings_Click"
                            ToolTip="外観設定" Margin="1,0,0,0">
                        <TextBlock Text="⚙" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnClose" Width="24" Height="24"
                            Style="{StaticResource WgBtn}" Click="BtnClose_Click"
                            ToolTip="閉じる" Margin="1,0,0,0">
                        <TextBlock x:Name="TxtCloseIcon" Text="✕" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ 曜日ヘッダー ═══ -->
            <UniformGrid Grid.Row="1" x:Name="DayHeaderGrid"
                         Columns="7" Margin="4,0,4,2"/>

            <!-- ═══ カレンダーグリッド ═══ -->
            <UniformGrid Grid.Row="2" x:Name="CalGrid"
                         Columns="7" Margin="4,0,4,4"/>

            <!-- ═══ リサイズグリップ ═══ -->
            <Border Grid.Row="3" HorizontalAlignment="Right"
                    Width="14" Height="14" Cursor="SizeNWSE"
                    MouseLeftButtonDown="ResizeGrip_MouseDown"
                    VerticalAlignment="Bottom" Margin="0,0,2,2">
                <TextBlock x:Name="TxtResizeGrip" Text="⠿" FontSize="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
